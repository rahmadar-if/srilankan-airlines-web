# --- Creatio connection ---
# The browser calls Creatio's CaptureService directly for all Contact/activity
# writes (see creatio/CaptureService.cs). The only thing that still happens
# server-side is exchanging the OAuth2 client_secret for a short-lived bearer
# token (server/creatio-token.js via api/creatio-token.js) — that secret must
# never reach the browser.

# Public — sent to the browser bundle, this is just Creatio's own domain.
VITE_CREATIO_BASE_URL=https://yourinstance.creatio.com

# Server-side only. Base URL used to derive the Identity Service token URL
# below when CREATIO_IDENTITY_URL is unset.
CREATIO_BASE_URL=https://yourinstance.creatio.com

# Identity Service token URL. Cloud instances follow the "<name>-is.creatio.com"
# convention, auto-derived from CREATIO_BASE_URL if left unset.
# CREATIO_IDENTITY_URL=https://yourinstance-is.creatio.com

# OAuth 2.0 client credentials for a DEDICATED, narrowly-scoped Integrated
# Application — grant it ONLY Contact + UsrWebActivity access, nothing else.
# Created in Creatio under:
# System Designer -> Import and integration -> OAuth 2.0 Integrated Applications
# The resulting bearer token (not this secret) is what the browser gets.
CREATIO_PUBLIC_CLIENT_ID=
CREATIO_PUBLIC_CLIENT_SECRET=

# --- Google Tag Manager ---
# Container ID from tagmanager.google.com. Baked into index.html at build
# time via Vite's %VITE_GTM_ID% HTML replacement — changing this value needs
# a rebuild/redeploy to take effect, same as any other VITE_ var.
# GA4 is NOT configured here — it's wired up as a tag inside this GTM
# container (GTM UI), so it and any future tag (Ads conversion, etc.) can
# change without touching code.
VITE_GTM_ID=GTM-XXXXXXX
