//RefX Flow
$(document).ready(function () {
    $("#btnMybSearch").click(function (event) {

        var lastName = $("#lastname2refx").val();
        var recLoc = $("#bookref2refx").val();

        mybProcess(recLoc, lastName);
    });
});

function mybProcess(recLoc, lastName) {

    var selectedLang = $('#languageSelect').find(":selected").attr("data-value");
    var match = currentUrl.match(/\.com\/([^\/]+)/);

    if (match && match.length > 1) {
        selectedLang = match[1];
    } else {
        console.log('Value not found in the URL');
    }

    // URL where you want to send the JSON data
    var websiteLink = window.location.host;

    //LIVE OR STG
    if (websiteLink === "www.srilankan.com" || websiteLink === "srilankanstg.srilankan.com") {
        var baseUrl = 'https://digital.srilankan.com/booking/manage-booking/retrieve';
    }
    //TEST
    else if (websiteLink === "srilankantest.srilankan.com") {
        var baseUrl = 'https://uat.digital.airline.amadeus.com/ul/booking/manage-booking/retrieve';
    }
    //LOCALHOST
    else if (websiteLink === "localhost:39734") {
        var baseUrl = 'https://uat.digital.airline.amadeus.com/ul/booking/manage-booking/retrieve';
    }

    var langCode = mapLanguageCode(selectedLang);

    var langParam = 'lang=' + langCode;
    var url = baseUrl + '?' + langParam;

    // Create a form dynamically
    var form = document.createElement('form');
    form.setAttribute('method', 'post');
    form.setAttribute('action', url);

    // Add JSON parameters as hidden input fields
    var recLocInput = document.createElement('input');
    recLocInput.setAttribute('type', 'hidden');
    recLocInput.setAttribute('name', 'recLoc');
    recLocInput.setAttribute('value', recLoc);
    form.appendChild(recLocInput);

    var lastNameInput = document.createElement('input');
    lastNameInput.setAttribute('type', 'hidden');
    lastNameInput.setAttribute('name', 'lastName');
    lastNameInput.setAttribute('value', lastName);
    form.appendChild(lastNameInput);

    // Append the form to the document body
    document.body.appendChild(form);

    // Submit the form
    form.submit();
}