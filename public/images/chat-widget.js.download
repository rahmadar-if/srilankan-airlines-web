                        }
                    }
                });
            } catch (e) {
                // Cross-origin stylesheet, can't access
                debugLog(`Stylesheet ${index} blocked (cross-origin)`);
            }
        });

        if (suspiciousRules.length > 0) {
            debugLog('⚠️ Found potentially interfering CSS rules:', suspiciousRules);
        } else {
            debugLog('✅ No obvious interfering CSS rules detected');
