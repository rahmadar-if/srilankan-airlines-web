    // first crosses 150 px, and this final correction when animation completes.
    // Two passes vs. the original 6-7 eliminates the over-lift while still
    // keeping content visible during the animation.
    let midAnimationResizeTimer = null;

    // Store adjustIframeForKeyboard in window scope so forceIframeResize can access it
    let adjustIframeForKeyboard = null;

    // ── iOS Safari auto-zoom prevention ──────────────────────────────────────
    // iOS Safari zooms the viewport when an input with font-size < 16px is
    // focused. Because our inputs live inside an iframe, this zooms the *parent*
    // page and makes the whole widget appear to jump / scale. We block that by
    // temporarily setting maximum-scale=1 while an iframe input is active.
    let _iosOriginalViewportContent = null;

    function preventIOSInputZoom() {
        // Only iOS Safari exhibits this behaviour
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        if (!isIOS) return;

        let viewportMeta = document.querySelector('meta[name="viewport"]');
        if (!viewportMeta) {
            viewportMeta = document.createElement('meta');
            viewportMeta.name = 'viewport';
            viewportMeta.content = 'width=device-width, initial-scale=1';
            document.head.appendChild(viewportMeta);
        }

        // Save original content so we can restore it later
        _iosOriginalViewportContent = viewportMeta.content;

        // Strip any existing maximum-scale / user-scalable directives, then
        // append our own to block automatic zoom on input focus.
        const stripped = viewportMeta.content
            .replace(/,?\s*maximum-scale=[^,]*/gi, '')
            .replace(/,?\s*user-scalable=[^,]*/gi, '');
        viewportMeta.content = stripped + ', maximum-scale=1, user-scalable=no';
        debugLog('[iOS] Zoom prevention active on viewport');
    }

    function restoreIOSInputZoom() {
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        if (!isIOS) return;

        if (_iosOriginalViewportContent !== null) {
            const viewportMeta = document.querySelector('meta[name="viewport"]');
            if (viewportMeta) {
