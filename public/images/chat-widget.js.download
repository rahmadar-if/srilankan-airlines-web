                        keyboardMonitoringActive = false;
                        debugLog('📱 Keyboard monitoring deactivated (blur)');

                        // Force reset to full screen height
                        const fullHeight = window.innerHeight;
                        chatContainer.style.height = `${fullHeight}px`;
                        chatContainer.style.top = '0px';
                        iframe.style.height = `${fullHeight}px`;

                        // Force reflow
                        void chatContainer.offsetHeight;
                        void iframe.offsetHeight;

                        // Dispatch resize event to Flutter
                        triggerIframeResize();
                    }
                }, 400); // Wait a bit longer for keyboard animation
            }
        }

        // Handle debug messages from Flutter (for mobile debugging)
        if (event.data && event.data.type === 'flutterDebug') {
            debugLog('[Flutter]', event.data.message);
        }
    });

    // Enhanced focus management for parent-iframe interaction
    let iframeHasFocus = false;
    let parentFocusTimeout = null;

    // Track focus state of iframe
    iframe.addEventListener('focus', () => {
        debugLog('[FocusManager] Iframe gained focus');
        iframeHasFocus = true;
    });

    iframe.addEventListener('blur', () => {
        debugLog('[FocusManager] Iframe lost focus');
        iframeHasFocus = false;
    });

    // Listen for focus events on the parent window
    window.addEventListener('focus', (event) => {
        // Clear any pending timeout
        if (parentFocusTimeout) {
            clearTimeout(parentFocusTimeout);
            parentFocusTimeout = null;
        }

        // Delay to avoid immediate focus conflicts
        parentFocusTimeout = setTimeout(() => {
            if (!chatContainer.classList.contains('hidden') && iframeHasFocus) {
                debugLog('[FocusManager] Parent window gained focus, notifying iframe');
                try {
                    iframe.contentWindow.postMessage({
                        type: 'parentFocusChanged',
                        hasFocus: true
                    }, '*');
                } catch (error) {
                    debugLog('[FocusManager] Error notifying iframe of parent focus:', error);
                }
            }
        }, 100);
    });

    // Listen for clicks on parent document (outside iframe)
    document.addEventListener('click', (event) => {
        // Check if click is outside the chat widget container using composedPath for Shadow DOM
        const clickPath = event.composedPath();
        const clickedInsideWidget = clickPath.some(element => element === widgetContainer);

        if (!clickedInsideWidget) {
            debugLog('[FocusManager] Click detected on parent document outside widget');

            // If chat is open and click is outside, notify iframe to release focus
            if (!chatContainer.classList.contains('hidden')) {
                try {
                    iframe.contentWindow.postMessage({
                        type: 'parentElementClicked',
                        shouldReleaseFocus: true
                    }, '*');
                    debugLog('[FocusManager] Sent focus release notification to iframe');
                } catch (error) {
                    debugLog('[FocusManager] Error notifying iframe of parent click:', error);
                }
            }
        }
    });

    // Listen for focus events on any input/textarea in parent document
    document.addEventListener('focusin', (event) => {
        // Check if the focused element is an input or textarea
        const focusedElement = event.target;
        if (focusedElement && (
            focusedElement.tagName === 'INPUT' ||
            focusedElement.tagName === 'TEXTAREA' ||
            focusedElement.contentEditable === 'true'
        )) {
            debugLog('[FocusManager] Parent input element gained focus:', focusedElement.tagName);

            // Notify iframe to release focus if chat is open
            if (!chatContainer.classList.contains('hidden')) {
                try {
                    iframe.contentWindow.postMessage({
                        type: 'parentInputFocused',
                        shouldReleaseFocus: true
                    }, '*');
                    debugLog('[FocusManager] Notified iframe that parent input gained focus');
                } catch (error) {
                    debugLog('[FocusManager] Error notifying iframe of parent input focus:', error);
                }
            }
        }
    });

    // Handle visibility change (tab switching)
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            debugLog('[FocusManager] Document became hidden (tab switched)');
            // Notify iframe when tab loses visibility
            if (!chatContainer.classList.contains('hidden')) {
                try {
                    iframe.contentWindow.postMessage({
                        type: 'visibilityChanged',
                        isVisible: false
                    }, '*');
                } catch (error) {
                    debugLog('[FocusManager] Error notifying iframe of visibility change:', error);
                }
            }
        } else {
            debugLog('[FocusManager] Document became visible (tab returned)');
            // Notify iframe when tab regains visibility
            if (!chatContainer.classList.contains('hidden')) {
                try {
                    iframe.contentWindow.postMessage({
                        type: 'visibilityChanged',
                        isVisible: true
                    }, '*');
                } catch (error) {
                    debugLog('[FocusManager] Error notifying iframe of visibility change:', error);
                }
            }
        }
    });

    // Use mousedown for better responsiveness even when input is focused
    restartChatBtn.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();

        // Prevent multiple rapid clicks
        if (restartChatBtn.disabled) {
            debugLog("Restart chat already in progress, ignoring click");
            return;
        }

        // Disable button temporarily to prevent multiple clicks
        restartChatBtn.disabled = true;
        restartChatBtn.style.opacity = '0.5';

        debugLog("Restarting chat and clearing stored credentials");
        clearStoredCredentials(); // Clear all credentials

        // Don't disable new chat button here - let the login status determine the state
        // The button will be disabled when user is actually on login screen
        debugLog("Credentials cleared, but not disabling new chat button - let login status determine state");

        try {
            iframe.contentWindow.postMessage({ type: "restartChat" }, "*");
        } catch (error) {
            console.error("Error sending restartChat message to iframe:", error);
        }
        dropdown.classList.add('hidden'); // Hide dropdown after click
        iframeOverlay.classList.add('hidden'); // Hide overlay after click

        // Re-enable restart button after a delay, but keep new chat disabled
        setTimeout(() => {
            restartChatBtn.disabled = false;
            restartChatBtn.style.opacity = '1';
            // Don't re-enable new chat - it stays disabled until user logs in
        }, 2000); // 2 second delay
    });

    // Prevent default click behavior
    restartChatBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
    });

    // Use mousedown for better responsiveness even when input is focused
    newChatBtn.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();

        // Prevent multiple rapid clicks and check if button is disabled
        if (newChatBtn.disabled) {
            debugLog("New chat button is disabled, ignoring click");
            return;
        }

        // Disable button temporarily to prevent multiple clicks
        newChatBtn.disabled = true;
        newChatBtn.style.opacity = '0.5';
        newChatBtn.style.cursor = 'not-allowed';
        newChatBtn.style.color = '#999';
        newChatBtn.style.backgroundColor = '';

        debugLog("Starting new chat - clearing stored credentials");
        const navigationState = getEncryptedStorage(localStorage, STORAGE_KEYS.NAVIGATION_STATE);
        debugLog("Navigation state for new chat:", navigationState);
        if (navigationState !== '/') {
            debugLog("Clearing stored credentials as navigation state is not '/'");
            clearStoredCredentials();
        } else {
            debugLog("Skipping credential clearing as navigation state is '/'");
        }
        try {
            iframe.contentWindow.postMessage({ type: "newChat" }, "*");
        } catch (error) {
            console.error("Error sending newChat message to iframe:", error);
        }
        dropdown.classList.add('hidden');
        iframeOverlay.classList.add('hidden'); // Hide overlay after click

        // Re-enable button after a delay
        setTimeout(() => {
            newChatBtn.disabled = false;
            newChatBtn.classList.remove('disabled');
            newChatBtn.style.opacity = '1';
            newChatBtn.style.cursor = 'pointer';
            newChatBtn.style.backgroundColor = '';
        }, 2000); // 2 second delay
    });

    // Prevent default click behavior
    newChatBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
    });


    // Function to reset chat bubble to default position
    const resetBubblePosition = () => {
        const chatBubble = shadowRoot.getElementById('floating-chat-bubble');
        chatBubble.style.left = 'auto';
        chatBubble.style.top = 'auto';
        // Set to default bottom-right position
        chatBubble.style.right = defaultPosition.right;
        chatBubble.style.bottom = defaultPosition.bottom;
    };

    // Dragging functionality with boundary enforcement
    chatBubble.addEventListener('mousedown', (e) => {
        isDragging = true;
        isClick = true; // Assume it's a click until proven otherwise
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        const rect = chatBubble.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;
        e.preventDefault(); // Prevent text selection
    });

    document.addEventListener('mousemove', (e) => {
        if (isDragging) {
            const deltaX = e.clientX - dragStartX;
            const deltaY = e.clientY - dragStartY;

            // If moved significantly, it's a drag, not a click
            if (Math.abs(deltaX) > 10 || Math.abs(deltaY) > 10) {
                isClick = false;
            }

            let newLeft = initialLeft + deltaX;
            let newTop = initialTop + deltaY;

            // Define the draggable boundary (square from bottom-right corner)
            const bubbleWidth = chatBubble.offsetWidth;
            const bubbleHeight = chatBubble.offsetHeight;
            const defaultRightPx = parseInt(defaultPosition.right);
            const defaultBottomPx = parseInt(defaultPosition.bottom);

            // Calculate boundaries for the 1000x1000 square from bottom-right
            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;

            const minLeft = Math.max(0, viewportWidth - 1000 - defaultRightPx);
            const maxLeft = viewportWidth - bubbleWidth - defaultRightPx;
            const minTop = Math.max(0, viewportHeight - 1000 - defaultBottomPx);
            const maxTop = viewportHeight - bubbleHeight - defaultBottomPx;

            // Check if the new position is within the allowed square area
            if (newLeft >= minLeft && newLeft <= maxLeft && newTop >= minTop && newTop <= maxTop) {
                // Within bounds, update position
                chatBubble.style.position = 'fixed';
                chatBubble.style.left = newLeft + 'px';
                chatBubble.style.top = newTop + 'px';
                chatBubble.style.right = 'auto';
                chatBubble.style.bottom = 'auto';
            } else {
                // Outside bounds, reset to default position
                resetBubblePosition();
            }
        }
    });

    document.addEventListener('mouseup', () => {
        // Only reset dragging if we're not currently resizing
        if (!isResizing) {
            isDragging = false;
        }
    });

    let isExpanded = true; // Default to expanded


    chatBubble.addEventListener('click', (e) => {
        if (isClick) {
            if (chatContainer.classList.contains('hidden')) {
                chatContainer.classList.remove('hidden');

                // Lock parent scroll when widget opens
                if (window.lockParentScroll) {
                    window.lockParentScroll();
                }

                // Update dimensions before setting initial view
                dimensions = calculateResponsiveDimensions();
                if (dimensions.isMobileDevice) {
                    // Mobile: force collapsed view only
                    chatContainer.classList.add('collapsed');
                    isExpanded = false;

                    console.log('📱 [CHAT-WIDGET] [BUBBLE CLICK] Mobile device detected, forcing full-screen positioning');

                    // CRITICAL: Use setAttribute for maximum override power
                    chatContainer.setAttribute('style', `
                        position: fixed !important;
                        width: 100vw !important;
                        height: 100dvh !important;
                        top: 0px !important;
                        bottom: 0px !important;
                        left: 0px !important;
                        right: 0px !important;
                        margin: 0px !important;
                        padding: 0px !important;
                        border-radius: 0px !important;
                        transform: none !important;
                        max-width: 100vw !important;
                        max-height: 100dvh !important;
                        min-width: 100vw !important;
                        min-height: 100dvh !important;
                    `);

                    // Force reflow to apply styles
                    void chatContainer.offsetHeight;

                    // CRITICAL FIX: Double-check positioning after opening
                    setTimeout(() => {
                        const computedStyle = window.getComputedStyle(chatContainer);
                        console.log('📊 [CHAT-WIDGET] [BUBBLE CLICK] Computed styles after 50ms:', {
                            position: computedStyle.position,
                            top: computedStyle.top,
                            width: computedStyle.width,
                            height: computedStyle.height
                        });

                        if (computedStyle.top !== '0px' || computedStyle.position !== 'fixed') {
                            console.log('🚨 [CHAT-WIDGET] [BUBBLE CLICK] POSITIONING WRONG! Re-forcing mobile positioning');
                            console.log('[CHAT-WIDGET] Expected: position=fixed, top=0px');
                            console.log('[CHAT-WIDGET] Got: position=' + computedStyle.position + ', top=' + computedStyle.top);
                            chatContainer.setAttribute('style', `
                                position: fixed !important;
                                width: 100vw !important;
                                height: 100dvh !important;
                                top: 0px !important;
                                bottom: 0px !important;
                                left: 0px !important;
                                right: 0px !important;
                                margin: 0px !important;
                                padding: 0px !important;
                                border-radius: 0px !important;
                                transform: none !important;
                                max-width: 100vw !important;
                                max-height: 100dvh !important;
                                min-width: 100vw !important;
                                min-height: 100dvh !important;
                            `);
                        }
                    }, 50);

                    // Explicitly check keyboard state on open
                    // CRITICAL FIX: Don't activate monitoring on bubble click
                    // Only activate when input is focused (inputFocused message)
                    if (window.visualViewport) {
                        const viewportHeight = window.visualViewport.height;
                        const windowHeight = window.innerHeight;
                        const keyboardOpen = windowHeight - viewportHeight > 150;

                        if (keyboardOpen) {
                            // Keyboard is open - adjust iframe but DON'T activate monitoring yet
                            debugLog('📱 Keyboard detected open on bubble click - adjusting iframe (monitoring stays inactive)');
                            chatContainer.style.height = `${viewportHeight}px`;
                            chatContainer.style.top = '0px';
                            chatContainer.style.bottom = 'auto';
                            chatContainer.style.minHeight = '0px';
                            chatContainer.style.maxHeight = 'none';
                        }
                        // Note: monitoring will be activated when input is focused
                    }
                } else {

                    // Set initial view based on defaultView parameter
                    if (defaultView === 'expanded') {
                        chatContainer.classList.add('expanded');
                        chatContainer.style.width = `${dimensions.expandedWidth}px`;
                        chatContainer.style.height = `${dimensions.expandedHeight}px`;

                        isExpanded = true;
                        // Update expand button icon and tooltip
                        const expandIcon = expandBtn.querySelector('.expand-icon');
                        if (expandIcon) expandIcon.innerHTML = SVG_ICONS.COLLAPSE;
                    } else {
                        chatContainer.classList.remove('expanded');
                        chatContainer.style.width = `${dimensions.collapsedWidth}px`;
                        chatContainer.style.height = `${dimensions.collapsedHeight}px`;

                        isExpanded = false;
                        // Ensure expand button icon is in collapse state
                        const expandIcon = expandBtn.querySelector('.expand-icon');
                        if (expandIcon) expandIcon.innerHTML = SVG_ICONS.EXPAND;
                    }
                }

                // Hide tooltip when chat container is shown
                const tooltipContainer = chatBubble.querySelector('.tooltip-container');
                const tooltipArrow = chatBubble.querySelector('.tooltip-arrow');
                const tooltipMessage = chatBubble.querySelector('.tooltip-message');

                // Notify Flutter app that widget is opened
                try {
                    iframe.contentWindow.postMessage({
                        type: 'widgetStateChanged',
                        isOpen: true
                    }, '*');
                    // Update global state for outside click detection
                    window._liaWidgetIsOpen = true;
                    debugLog('[Widget] Widget opened - state updated');
                } catch (error) {
                    debugLog('Error sending widget opened message:', error);
                }

                if (tooltipContainer && tooltipArrow && tooltipMessage) {
                    if (window._liaTooltipTimeout) {
                        clearTimeout(window._liaTooltipTimeout);
                    }
                    tooltipContainer.style.display = 'none';
                    tooltipArrow.style.display = 'none';
                    tooltipMessage.style.display = 'none';
                    tooltipMessage.style.opacity = '0';
                }

                // Fix position to bottom corner (only for desktop)
                if (!dimensions.isMobileDevice) {
                    chatContainer.style.position = 'fixed';
                    chatContainer.style.bottom = '0';
                    chatContainer.style.top = 'auto';
                    chatContainer.style.margin = '0';
                    chatContainer.style.right = '0';
                    chatContainer.style.left = 'auto';
                }
                // On mobile, CSS handles everything

                // Hide the chat bubble when container is displayed
                chatBubble.style.display = 'none';
            } else {
                chatContainer.classList.add('hidden');

                // Disable keyboard monitoring
                keyboardMonitoringActive = false;
                // Reset height/top styles
                chatContainer.style.height = '';
                chatContainer.style.top = '';

                // Reset state based on device type
                if (dimensions.isMobileDevice) {
                    isExpanded = false; // Always collapsed on mobile
                } else {
                    isExpanded = defaultView === 'expanded'; // Reset to default view state on desktop
                }

                // --- RESTART ANIMATION WHEN BUBBLE IS SHOWN AGAIN ---
                if (animationTimeout) clearTimeout(animationTimeout);
                if (animation === true) {
                    chatBubble.style.animationName = 'popInOut';
                    chatBubble.style.animationPlayState = 'running';
                } else {
                    chatBubble.style.animationName = 'none';
                    chatBubble.style.animationPlayState = 'paused';
                }
                // Re-display tooltip after chat bubble is visible again
                const tooltipContainer = chatBubble.querySelector('.tooltip-container');
                const tooltipArrow = chatBubble.querySelector('.tooltip-arrow');
                const tooltipMessage = chatBubble.querySelector('.tooltip-message');

                if (tooltip === true && tooltipContainer && tooltipArrow && tooltipMessage && chatBubble.style.display === 'flex') {
                    const messages = chatBubbleTip.split(',').map(msg => msg.trim()).filter(msg => msg !== '');
                    if (messages.length > 0) {
                        if (window._liaTooltipTimeout) {
                            clearTimeout(window._liaTooltipTimeout);
                        }
                        window._liaTooltipTimeout = setTimeout(() => {
                            // Show tooltip container and arrow first
                            tooltipContainer.style.display = 'flex';
                            tooltipArrow.style.display = 'block';

                            // Add delay before showing the message
                            setTimeout(() => {
                                if (staticChatBubbleTipEnabled) {
                                    tooltipMessage.textContent = messages[0];
                                    tooltipMessage.style.display = 'flex';
                                    tooltipMessage.style.opacity = '0';
                                    tooltipMessage.style.transition = 'opacity 0.3s ease';
                                    setTimeout(() => {
                                        tooltipMessage.style.opacity = '1';
                                    }, 10);
                                } else {
                                    let currentIndex = 0;
                                    const displayNextMessage = () => {
                                        tooltipMessage.textContent = messages[currentIndex];
                                        tooltipMessage.style.display = 'flex';
                                        tooltipMessage.style.opacity = '0';
                                        tooltipMessage.style.transition = 'opacity 0.3s ease';
                                        setTimeout(() => {
                                            tooltipMessage.style.opacity = '1';
                                        }, 10);
                                        currentIndex = (currentIndex + 1) % messages.length;
                                        window._liaTooltipTimeout = setTimeout(displayNextMessage, 3000);
                                    };
                                    displayNextMessage();
                                }
                            }, 400); // Delay before showing message
                        }, 300); // 100ms delay to ensure chat bubble is rendered
                    }
                }

                // Unlock parent scroll when widget closes
                if (window.unlockParentScroll) {
                    window.unlockParentScroll();
                }

                // Show the chat bubble when container is closed
                chatBubble.style.display = 'block';

                // Notify Flutter app that widget is closed
                try {
                    iframe.contentWindow.postMessage({
                        type: 'widgetStateChanged',
                        isOpen: false
                    }, '*');
                    // Update global state for outside click detection
                    window._liaWidgetIsOpen = false;
                    debugLog('[Widget] Widget closed via bubble click - state updated');
                } catch (error) {
                    debugLog('Error sending widget closed message:', error);
                }
            }
        }
    });
    // Call resetBubblePosition initially
    resetBubblePosition();

    // Note: Resize handler already added above, no need for duplicate

    closeBtn.addEventListener('click', () => {
        // Hide the chat container when close button is clicked
        chatContainer.classList.add('hidden');
        isExpanded = defaultView === 'expanded'; // Reset to default view state

        // Stop style enforcement when closing
        stopStyleEnforcement();

        // Unlock parent scroll when widget closes
        if (window.unlockParentScroll) {
            window.unlockParentScroll();
        }

        // Disable keyboard monitoring
        keyboardMonitoringActive = false;
        // Reset height/top styles
        chatContainer.style.height = '';
        chatContainer.style.top = '';

        // Show the chat bubble when container is closed (use 'flex' to match tooltip condition)
        chatBubble.style.display = 'flex';

        // Notify Flutter app that widget is closed
        try {
            iframe.contentWindow.postMessage({
                type: 'widgetStateChanged',
                isOpen: false
            }, '*');
            // Update global state for outside click detection
            window._liaWidgetIsOpen = false;
            debugLog('[Widget] Widget closed via close button - state updated');
        } catch (error) {
            debugLog('Error sending widget closed message:', error);
        }
    });

    expandBtn.addEventListener('click', () => {

        const expandIcon = expandBtn.querySelector('.expand-icon');
        const tooltip = expandBtn.querySelector('.tooltip');

        // Update dimensions before toggling state
        dimensions = calculateResponsiveDimensions();

        // Expand/collapse only works on desktop (mobile always full screen)
        if (dimensions.isMobileDevice) {
            debugLog('Expand button clicked on mobile - ignoring (mobile always full screen)');
            return;
        }

        if (!isExpanded) {
            chatContainer.classList.add('expanded');
            chatContainer.classList.remove('hidden');
            chatContainer.style.width = `${dimensions.expandedWidth}px`;
            chatContainer.style.height = `${dimensions.expandedHeight}px`;
            chatContainer.style.top = 'auto'; // Start below the navbar
            chatContainer.style.left = 'auto';
            chatContainer.style.bottom = '0';
            chatContainer.style.right = '0';
            if (expandIcon) expandIcon.innerHTML = SVG_ICONS.COLLAPSE;
            if (tooltip) tooltip.textContent = "Collapse";
            debugLog("expanded");
        } else {
            chatContainer.classList.remove('expanded');
            chatContainer.classList.remove('hidden');
            chatContainer.style.width = `${dimensions.collapsedWidth}px`;
            chatContainer.style.height = `${dimensions.collapsedHeight}px`;
            chatContainer.style.top = 'auto';
            chatContainer.style.left = 'auto';
            chatContainer.style.bottom = '0';
            chatContainer.style.right = '0';
            if (expandIcon) expandIcon.innerHTML = SVG_ICONS.EXPAND;
            if (tooltip) tooltip.textContent = "Expand";
            debugLog("collapse");
        }

        isExpanded = !isExpanded;
    });

    let isResizing = false;
    let resizeDirection = '';
    let startX, startY, startWidth, startHeight, startLeft, startTop;
    let lastResizeEndTime = 0;

    // Add event listeners to all resize handles
    shadowRoot.querySelectorAll('.resize-handle').forEach(handle => {
        handle.addEventListener('mousedown', (e) => {
            // Only start resizing on left-click (button 0)
            if (e.button !== 0) return;

            isResizing = true;
            resizeDirection = handle.getAttribute('data-direction');

            // Prevent this from being interpreted as a click or drag on the bubble
            isClick = false;
            isDragging = false;

            // Remove expanded class if it exists when starting to resize
            if (chatContainer.classList.contains('expanded')) {
                chatContainer.classList.remove('expanded');
                isExpanded = false;

                // Update the expand icon back to expand state
                const expandIcon = expandBtn.querySelector('.expand-icon');
                const tooltip = expandBtn.querySelector('.tooltip');
                if (expandIcon) expandIcon.innerHTML = SVG_ICONS.EXPAND;
                if (tooltip) tooltip.textContent = "Expand";
            }

            startX = e.clientX;
            startY = e.clientY;

            const rect = chatContainer.getBoundingClientRect();
            startWidth = rect.width;
            startHeight = rect.height;
            startLeft = rect.left;
            startTop = rect.top;

            e.preventDefault();
            e.stopPropagation();

            iframe.style.pointerEvents = 'none';  // Temporarily disable so it doesn't eat mouseup
        });
        // Prevent click events from bubbling up from resize handles
        handle.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
        });
    });

    document.addEventListener('mousemove', (e) => {
        if (isResizing) {
            const deltaX = e.clientX - startX;
            const deltaY = e.clientY - startY;

            let newWidth = startWidth;
            let newHeight = startHeight;
            let newLeft = startLeft;
            let newTop = startTop;

            // Calculate new dimensions based on resize direction (North, West, Northwest only)
            switch (resizeDirection) {
                case 'n': // North (top)
                    newHeight = Math.max(dimensions.minHeight, startHeight - deltaY);
                    newTop = startTop + (startHeight - newHeight);
                    break;
                case 'w': // West (left)
                    newWidth = Math.max(dimensions.minWidth, startWidth - deltaX);
                    newLeft = startLeft + (startWidth - newWidth);
                    break;
                case 'nw': // Northwest (top-left)
                    newWidth = Math.max(dimensions.minWidth, startWidth - deltaX);
                    newHeight = Math.max(dimensions.minHeight, startHeight - deltaY);
                    newLeft = startLeft + (startWidth - newWidth);
                    newTop = startTop + (startHeight - newHeight);
                    break;
            }

            // Apply maximum constraints
            // Allow height and width to go up to expanded dimensions
            const effectiveMaxHeight = Math.max(maxHeight, dimensions.expandedHeight);
            const effectiveMaxWidth = Math.max(maxWidth, dimensions.expandedWidth);
            newWidth = Math.min(newWidth, effectiveMaxWidth);
            newHeight = Math.min(newHeight, effectiveMaxHeight);

            // Apply the new dimensions
            chatContainer.style.width = newWidth + 'px';
            chatContainer.style.height = newHeight + 'px';

            // Check if we've reached expanded dimensions (within 5% tolerance)
            const widthThreshold = dimensions.expandedWidth * 0.95;
            const heightThreshold = dimensions.expandedHeight * 0.95;
            const isNearExpandedSize = newWidth >= widthThreshold && newHeight >= heightThreshold;

            // Update expand/collapse state and icon if we've reached expanded size
            if (isNearExpandedSize && !isExpanded) {
                chatContainer.classList.add('expanded');
                isExpanded = true;
                const expandIcon = expandBtn.querySelector('.expand-icon');
                const tooltip = expandBtn.querySelector('.tooltip');
                if (expandIcon) expandIcon.innerHTML = SVG_ICONS.COLLAPSE;
                if (tooltip) tooltip.textContent = "Collapse";
            } else if (!isNearExpandedSize && isExpanded) {
                chatContainer.classList.remove('expanded');
                isExpanded = false;
                const expandIcon = expandBtn.querySelector('.expand-icon');
                const tooltip = expandBtn.querySelector('.tooltip');
                if (expandIcon) expandIcon.innerHTML = SVG_ICONS.EXPAND;
                if (tooltip) tooltip.textContent = "Expand";
            }

            // Always keep bottom and right edges fixed to the screen edges
            chatContainer.style.position = 'fixed';
            chatContainer.style.bottom = '0';
            chatContainer.style.right = '0';
            chatContainer.style.left = 'auto';
            chatContainer.style.top = 'auto';
        }
    });

    document.addEventListener('mouseup', (e) => {
        if (isResizing) {
            // Stop resizing when left-click is released (button 0)
            if (e.button === 0) {
                // Check final size and update expand/collapse state
                const currentWidth = parseFloat(chatContainer.style.width);
                const currentHeight = parseFloat(chatContainer.style.height);
                const widthThreshold = dimensions.expandedWidth * 0.95;
                const heightThreshold = dimensions.expandedHeight * 0.95;
                const isNearExpandedSize = currentWidth >= widthThreshold && currentHeight >= heightThreshold;

                // Update expand/collapse state and icon based on final size
                const expandIcon = expandBtn.querySelector('.expand-icon');
                const tooltip = expandBtn.querySelector('.tooltip');

                if (isNearExpandedSize && !isExpanded) {
                    chatContainer.classList.add('expanded');
                    isExpanded = true;
                    if (expandIcon) expandIcon.innerHTML = SVG_ICONS.COLLAPSE;
                    if (tooltip) tooltip.textContent = "Collapse";
                } else if (!isNearExpandedSize && isExpanded) {
                    chatContainer.classList.remove('expanded');
                    isExpanded = false;
                    if (expandIcon) expandIcon.innerHTML = SVG_ICONS.EXPAND;
                    if (tooltip) tooltip.textContent = "Expand";
                }

                isResizing = false;
                resizeDirection = '';
                lastResizeEndTime = Date.now(); // Track when resize ended
                iframe.style.pointerEvents = 'auto';
            }
        }
    });

    // Prevent context menu on resize handles to avoid interference with resizing
    shadowRoot.querySelectorAll('.resize-handle').forEach(handle => {
        handle.addEventListener('contextmenu', (e) => {
            e.preventDefault();
        });
    });

    // Close dropdown when clicking anywhere outside - using shadowRoot for proper event handling
    const closeDropdownHandler = (e) => {
        // Check if click is outside both dropdown and moreBtn
        const clickedElement = e.target;
        const clickPath = e.composedPath ? e.composedPath() : [];

        // Check if click is within dropdown or moreBtn using composedPath for Shadow DOM
        // Filter out non-Node elements (like Window) to prevent contains() errors
        const isClickInDropdown = clickPath.some(el => {
            if (!el || !el.nodeType) return false; // Skip non-Node elements
            return el === dropdown || (dropdown && dropdown.contains(el));
        });
        const isClickInMoreBtn = clickPath.some(el => {
            if (!el || !el.nodeType) return false; // Skip non-Node elements
            return el === moreBtn || (moreBtn && moreBtn.contains(el));
        });

        // Only close if click is outside both dropdown and moreBtn
        if (!isClickInDropdown && !isClickInMoreBtn && !dropdown.classList.contains('hidden')) {
            dropdown.classList.add('hidden');
            iframeOverlay.classList.add('hidden'); // Also hide overlay
            debugLog('Dropdown closed by outside click, overlay hidden');
        }
    };

    // Listen for both mousedown and click events to catch all interactions
    // Using mousedown is important because we use mousedown for opening the dropdown
    // Use bubble phase (not capture) so specific element handlers fire first
    shadowRoot.addEventListener('mousedown', closeDropdownHandler, false);
    shadowRoot.addEventListener('click', closeDropdownHandler, false);

    // Also add to chatContainer to catch clicks within the widget
    chatContainer.addEventListener('mousedown', closeDropdownHandler, false);
    chatContainer.addEventListener('click', closeDropdownHandler, false);

    iframe.addEventListener('load', () => {
        debugLog('Iframe loaded successfully');

        // Send initial widget state after a delay to ensure Flutter's message listener is ready
        setTimeout(() => {
            const initialState = !chatContainer.classList.contains('hidden');
            try {
                iframe.contentWindow.postMessage({
                    type: 'widgetStateChanged',
                    isOpen: initialState
                }, '*');
                window._liaWidgetIsOpen = initialState;
                debugLog(`[Init] Sent initial widget state: ${initialState ? 'OPEN' : 'CLOSED'}`);
            } catch (error) {
                debugLog('[Init] Error sending initial widget state:', error);
            }
        }, 500); // 500ms delay to ensure Flutter app is ready

        // Listen for clicks inside iframe (will be handled by Flutter via postMessage)
        window.addEventListener('message', (event) => {
            if (event.data && event.data.type === 'iframeClicked') {
                dropdown.classList.add('hidden');
                iframeOverlay.classList.add('hidden');
                debugLog('Dropdown closed by iframe click message');
            }
        });
    });

    // Listen for clicks on the iframe element itself to close dropdown
    iframe.addEventListener('click', () => {
        if (!dropdown.classList.contains('hidden')) {
            dropdown.classList.add('hidden');
            iframeOverlay.classList.add('hidden');
            debugLog('Dropdown closed by iframe click');
        }
    });

    // Use mousedown instead of click to avoid focus issues with input field
    moreBtn.addEventListener('mousedown', (e) => {
        e.preventDefault();
        // Don't stop propagation - let the event bubble so closeDropdownHandler can handle outside clicks

        // Toggle dropdown visibility
        const isHidden = dropdown.classList.contains('hidden');
        if (isHidden) {
            dropdown.classList.remove('hidden');
            iframeOverlay.classList.remove('hidden'); // Show overlay when dropdown opens
            debugLog('Dropdown opened, overlay shown');
        } else {
            dropdown.classList.add('hidden');
            iframeOverlay.classList.add('hidden'); // Hide overlay when dropdown closes
            debugLog('Dropdown closed by moreBtn click, overlay hidden');
        }
    });

    // Prevent default click behavior to avoid double-triggering
    moreBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
    });

    // Add click listener to overlay to close dropdown when clicking on iframe area
    iframeOverlay.addEventListener('click', () => {
        if (!dropdown.classList.contains('hidden')) {
            dropdown.classList.add('hidden');
            iframeOverlay.classList.add('hidden');
            debugLog('Dropdown closed by overlay click');
        }
    });

    iframeOverlay.addEventListener('mousedown', (e) => {
        e.stopPropagation(); // Prevent event from bubbling to other handlers
    });

    // ===== OUTSIDE CLICK DETECTION FOR AUTO-CLOSING WIDGET =====
    // This detects clicks outside the chat widget and automatically closes it
    (function setupOutsideClickDetection() {
        // Use a global variable that can be accessed from outside this closure
        window._liaWidgetIsOpen = false;
        let lastStateChangeTime = 0;
        const MIN_STATE_CHANGE_INTERVAL = 150; // Minimum time between state changes in ms

        // Listen for clicks on the document
        document.addEventListener('click', (event) => {
            // Only process if widget is open
            if (!window._liaWidgetIsOpen) {
                return;
            }

            // Don't close if we're currently resizing
            if (isResizing) {
                debugLog('[OutsideClick] Ignoring click during resize operation');
                return;
            }

            // Prevent rapid state changes
            const now = Date.now();

            // Don't close if resize just ended (within 500ms grace period)
            if (now - lastResizeEndTime < 500) {
                debugLog('[OutsideClick] Ignoring click shortly after resize');
                return;
            }

            if (now - lastStateChangeTime < MIN_STATE_CHANGE_INTERVAL) {
                debugLog('[OutsideClick] Ignoring rapid click event');
                return;
            }

            // Check if click is inside the shadow DOM (widget container)
            const clickPath = event.composedPath();
            const clickedInsideWidget = clickPath.some(element => element === widgetContainer);

            if (!clickedInsideWidget) {
                debugLog('[OutsideClick] Click outside widget detected - closing widget');

                lastStateChangeTime = now;

                // Close the chat container
                chatContainer.classList.add('hidden');
                isExpanded = defaultView === 'expanded'; // Reset to default state
                chatBubble.style.display = 'flex'; // Show the bubble again

                // Unlock parent scroll when widget closes
                if (window.unlockParentScroll) {
                    window.unlockParentScroll();
                }

                // Update global state first
                window._liaWidgetIsOpen = false;

                // Then notify the iframe
                try {
                    iframe.contentWindow.postMessage({
                        type: 'widgetStateChanged',
                        isOpen: false
                    }, '*');
                    debugLog('[OutsideClick] Sent close notification to iframe');
                } catch (error) {
                    debugLog('[OutsideClick] Error notifying iframe:', error);
                }
            }
        }, true); // Use capture phase to catch clicks early

        debugLog('[OutsideClick] Outside click detection initialized');
    })();
    // ===== END OUTSIDE CLICK DETECTION =====

    // Initialize chat container size
    chatContainer.style.width = dimensions.minWidth + 'px';
    chatContainer.style.height = dimensions.minHeight + 'px';

    // Initialize scroll prevention
    const scrollPrevention = smoothScrollPrevention();

    // Store lock/unlock functions globally for easy access
    window.lockParentScroll = scrollPrevention.lock;
    window.unlockParentScroll = scrollPrevention.unlock;

    // ── Register with LiaWidget public API ──────────────────────────────────
    // Allows the host page to call window.LiaWidget.sendPrompt("...") to open
    // the bubble and fire a message programmatically (e.g. from their own search).
    if (window.LiaWidget && window.LiaWidget._register) {
      window.LiaWidget._register({
        type: 'bubble',
        iframe: iframe,
        open: function () {
          if (chatContainer.classList.contains('hidden')) {
            chatContainer.classList.remove('hidden');
            chatBubble.style.display = 'none';
            dimensions = calculateResponsiveDimensions();
            updateChatContainerSize(isExpanded);
            try {
              iframe.contentWindow.postMessage({ type: 'widgetStateChanged', isOpen: true }, '*');
              window._liaWidgetIsOpen = true;
            } catch (_) {}
          }
        },
        close: function () {
          if (!chatContainer.classList.contains('hidden')) {
            chatContainer.classList.add('hidden');
            chatBubble.style.display = 'flex';
            try {
              iframe.contentWindow.postMessage({ type: 'widgetStateChanged', isOpen: false }, '*');
              window._liaWidgetIsOpen = false;
            } catch (_) {}
          }
        },
        isOpen: function () {
          return !chatContainer.classList.contains('hidden');
        }
      });
    }
    // ────────────────────────────────────────────────────────────────────────

}

  // Expose initChatWidget to global scope for the bootstrap dispatcher below
  window.__museBubbleInit = initChatWidget;

})();

// =============================================================================
// WIDGET BOOTSTRAP  — added below existing code, nothing above changed
// =============================================================================
// Reads tenant_id → fetches /api/config → decides which widget to run:
//   widget_type = "SEARCHBAR" → load searchbar-widget.js, skip bubble
//   anything else / missing / error → run initChatWidget() as normal
// =============================================================================

(function () {

  // ── Config API base URLs ───────────────────────────────────────────────────
  var ENV_URLS = {
    dev:  "https://api-muse-dev.codegen.net",
    qa:   "https://api-muse-qa.codegen.net",
    uat:  "https://api-muse-uat.flairsuite.ai",
    prod: "https://api-muse-uat.flairsuite.ai",
    live: "https://api.liabots.ai"
  };

  // ── Read tenant_id and env from script tag src ─────────────────────────────
  var scriptEl  = document.currentScript ||
                  document.querySelector('script[src*="chat-widget.js"]');
  var scriptSrc = scriptEl ? scriptEl.src.replace(/&&+/g, "&") : "";

  var urlParams = {};
  try { new URL(scriptSrc).searchParams.forEach(function (v, k) { urlParams[k] = v; }); }
  catch (_) {}

  var wp       = window.chatParams || {};
  var tenantId = urlParams.tenant_id || urlParams.tenant || wp.tenant_id || wp.tenant || null;
  var env      = (urlParams.env || wp.env || "prod").toLowerCase();
  var apiBase  = ENV_URLS[env] || ENV_URLS["prod"];

  // ── Resolve searchbar-widget.js path (same folder as this script) ──────────
  var basePath     = scriptSrc.replace(/\/[^/?#]+(\?.*)?$/, "/");
  var searchbarSrc = basePath + "searchbar-widget.js";

  // ── Load chat-searchbar.js directly ──────────────────────────────────────
  //
  // WHY DIRECT: chat-searchbar.js ends with:
  //   document.addEventListener('DOMContentLoaded', initChatWidget)
  // When loaded dynamically AFTER the page has loaded, DOMContentLoaded has
  // already fired — so that listener never runs and nothing renders.
  //
  // FIX: load chat-searchbar.js, then on its onload callback, manually call
  // initChatWidget() if the DOM is already ready (readyState !== 'loading').
  //
  // We also pre-populate window.chatParams so chat-searchbar.js gets all
  // the tenant/theme/flutterBaseUrl values it needs (since the dynamic script
  // tag has no URL params and no data-flutter-base-url).
  function loadSearchBar(showBanner) {
    // ── Step 1: populate window.chatParams before the script loads ───────────
    var flutterBaseUrl = scriptEl ? (scriptEl.dataset.flutterBaseUrl || "") : "";
    window.chatParams = window.chatParams || {};

    Object.keys(urlParams).forEach(function (k) {
      window.chatParams[k] = urlParams[k];
    });
    window.chatParams.tenant         = window.chatParams.tenant || tenantId;
    window.chatParams.flutterBaseUrl = window.chatParams.flutterBaseUrl || flutterBaseUrl;

    // Propagate showBanner from API config as fullWidthSearch.
    // Only set from config when not already forced via URL param.
    if (!urlParams.fullWidthSearch) {
      window.chatParams.fullWidthSearch = showBanner ? "true" : "false";
    }

    console.info("[MuseWidget] window.chatParams ready for searchbar:", window.chatParams);

    // ── Step 2: load chat-searchbar.js directly (skip the alias) ────────────
    var chatSearchbarSrc = basePath + "chat-searchbar.js";
    var s = document.createElement("script");
    s.src = chatSearchbarSrc;

    // Forward data-* attributes as backup
    if (scriptEl) {
      [].forEach.call(scriptEl.attributes, function (attr) {
        if (attr.name !== "src") { try { s.setAttribute(attr.name, attr.value); } catch (_) {} }
      });
    }

    // ── Step 3: after script loads, call the SEARCHBAR's initChatWidget ─────
    // chat-searchbar.js declares initChatWidget() at global scope.
    // After it loads, window.initChatWidget IS the searchbar version.
    // We must call that — NOT window.__museBubbleInit (which is the bubble).
    // DOMContentLoaded has already fired so the searchbar's own listener
    // never triggers — we must kick it off manually here.
    s.onload = function () {
      console.info("[MuseWidget] chat-searchbar.js loaded");
      if (document.readyState !== "loading") {
        console.info("[MuseWidget] Calling searchbar initChatWidget()");
        // window.initChatWidget is now the searchbar version (overwritten on load)
        if (typeof window.initChatWidget === "function") {
          window.initChatWidget();
        }
      }
      // If DOM is still loading (unlikely), the script's own
      // DOMContentLoaded listener will fire normally.
    };

    s.onerror = function () {
      console.error("[MuseWidget] Failed to load chat-searchbar.js — falling back to bubble");
      window.__museBubbleInit();
    };

    document.head.appendChild(s);
  }

  // ── Fetch tenant config from API ───────────────────────────────────────────
  function fetchConfig(tid) {
    return fetch(apiBase + "/api/config?tenant_id=" + encodeURIComponent(tid), {
      headers: { "accept": "application/json" }
    })
    .then(function (res) { if (!res.ok) throw new Error("HTTP " + res.status); return res.json(); })
    .then(function (json) { return (json && json.config) ? json.config : json; });
  }

  // ── LiaWidget public API ──────────────────────────────────────────────────
  // Exposed on window.LiaWidget after any widget type initialises.
  // The host page can call:
  //   window.LiaWidget.open()
  //   window.LiaWidget.close()
  //   window.LiaWidget.sendPrompt("some message")  // opens + auto-sends
  //   window.LiaWidget.isOpen()
  //
  // Internal wiring is set by _registerLiaWidget() once the widget is ready.
  // ─────────────────────────────────────────────────────────────────────────
  window.LiaWidget = (function () {
    var _open    = null;
    var _close   = null;
    var _isOpen  = null;
    var _iframe  = null;
    var _pendingPrompts = []; // queue for prompts sent before widget is ready

    function _flushPending() {
      while (_pendingPrompts.length > 0) {
        var msg = _pendingPrompts.shift();
        _sendToIframe(msg);
      }
    }

    function _sendToIframe(text) {
      if (!_iframe || !_iframe.contentWindow) return;
      try {
        _iframe.contentWindow.postMessage({ type: 'sendMessage', message: text }, '*');
        console.info('[LiaWidget] sendPrompt dispatched:', text);
      } catch (e) {
        console.error('[LiaWidget] Error dispatching sendPrompt:', e);
      }
    }

    return {
      // Called internally once widget + iframe are ready
      _register: function (opts) {
        _open   = opts.open   || function () {};
        _close  = opts.close  || function () {};
        _isOpen = opts.isOpen || function () { return false; };
        _iframe = opts.iframe || null;
        console.info('[LiaWidget] API registered, type:', opts.type || 'unknown');
        _flushPending(); // deliver any prompts sent before init finished
      },

      open: function () {
        if (_open) _open();
        else console.warn('[LiaWidget] Widget not ready yet');
      },

      close: function () {
        if (_close) _close();
        else console.warn('[LiaWidget] Widget not ready yet');
      },

      isOpen: function () {
        return _isOpen ? _isOpen() : false;
      },

      // Opens the widget and immediately fires the prompt as a user message
      sendPrompt: function (text) {
        if (!text || !text.trim()) return;
        if (!_open) {
          // Widget not initialised yet — queue it
          _pendingPrompts.push(text);
          console.info('[LiaWidget] Widget not ready, queued prompt:', text);
          return;
        }
        // Open first (no-op if already open)
        _open();
        // Give the iframe a moment to become visible then send
        var delay = window.LiaWidget.isOpen() ? 0 : 400;
        setTimeout(function () { _sendToIframe(text); }, delay);
      }
    };
  })();

  // ── Load HEADLESS widget ──────────────────────────────────────────────────
  // Runs the full bubble widget internally but hides the floating bubble button.
  // The chat window opens/closes exactly like the bubble (positioned panel,
  // responsive, proper header) — just with no visible trigger on the page.
  // Everything is driven via window.LiaWidget.sendPrompt() / open() / close().
  function loadHeadless() {
    console.info("[MuseWidget] widget_type=HEADLESS → running bubble widget (bubble hidden)");

    // Populate window.chatParams so the bubble's initChatWidget can find tenant + flutterBaseUrl
    var flutterBaseUrl = scriptEl ? (scriptEl.dataset.flutterBaseUrl || "") : "";
    window.chatParams = window.chatParams || {};
    Object.keys(urlParams).forEach(function (k) { window.chatParams[k] = urlParams[k]; });
    window.chatParams.tenant         = window.chatParams.tenant || tenantId;
    window.chatParams.flutterBaseUrl = window.chatParams.flutterBaseUrl || flutterBaseUrl;

    // Run the full bubble init — this registers window.LiaWidget automatically
    window.__museBubbleInit();

    // Keep the floating bubble permanently hidden using a MutationObserver.
    // A one-time setProperty is not enough because Flutter's updateChatBubbleConfig
    // fires later and sets display:'flex' — overriding any one-shot hide.
    var attempts = 0;
    var hideInterval = setInterval(function () {
      attempts++;
      var wrapper = document.getElementById('chat-widget-wrapper');
      if (wrapper && wrapper.shadowRoot) {
        var bubble = wrapper.shadowRoot.getElementById('floating-chat-bubble');
        if (bubble) {
          // Force hide now
          bubble.style.setProperty('display', 'none', 'important');
          clearInterval(hideInterval);
          console.info("[LiaWidget] Headless: floating bubble hidden, attaching observer");

          // Watch for any future style changes on the bubble and re-hide
          var observer = new MutationObserver(function () {
            if (bubble.style.display !== 'none') {
              bubble.style.setProperty('display', 'none', 'important');
            }
          });
          observer.observe(bubble, { attributes: true, attributeFilter: ['style'] });
          return;
        }
      }
      if (attempts > 50) clearInterval(hideInterval);
    }, 100);
  }

  // ── Widget decision ────────────────────────────────────────────────────────
  function decideWidget(config) {
    // Store only tooltip-related API configs for fallback, because Flutter's
    // postMessage (updateChatBubbleConfig) may not include these newer fields.
    var bubbleCfg = (config && config.chat_bubble_configs) ? config.chat_bubble_configs : {};
    if (bubbleCfg.tooltipPersistent !== undefined || bubbleCfg.tooltipDismissAfter !== undefined) {
      window.__liaTooltipApiCfg = {
        tooltipPersistent:   bubbleCfg.tooltipPersistent,
        tooltipDismissAfter: bubbleCfg.tooltipDismissAfter
      };
    }

    // widget_type lives under config.chat_widget (API v2 shape)
    var chatWidget = (config && config.chat_widget) ? config.chat_widget : {};
    var type = chatWidget.widget_type
      ? chatWidget.widget_type.toString().toUpperCase().trim()
      : "BUBBLE";

    // showBanner replaces the old fullWidthSearch script-param approach.
    // Read it from config.chat_widget.showBanner (boolean).
    var showBanner = chatWidget.showBanner === true;

    if (type === "SEARCHBAR") {
      // Config says SEARCHBAR → load searchbar-widget.js, do NOT run bubble
      console.info("[MuseWidget] widget_type=SEARCHBAR → loading", searchbarSrc);
      loadSearchBar(showBanner);
    } else if (type === "HEADLESS") {
      // No visible UI — only window.LiaWidget API is active
      console.info("[MuseWidget] widget_type=HEADLESS → loading headless iframe");
      loadHeadless();
    } else {
      // Default: run existing chat bubble logic unchanged
      console.info("[MuseWidget] widget_type=" + type + " → running chat bubble");
      window.__museBubbleInit();
    }
  }

  // ── Bootstrap: run on DOMContentLoaded ────────────────────────────────────
  function bootstrap() {
    if (!tenantId) {
      // No tenant_id found — run bubble as before (safe fallback)
      return window.__museBubbleInit();
    }

    // Race: config fetch vs 2-second timeout (brief says 2s)
    // If API is slow, fall back to bubble immediately
    Promise.race([
      fetchConfig(tenantId),
      new Promise(function (resolve) { setTimeout(function () { resolve(null); }, 2000); })
    ])
    .then(function (config) {
      decideWidget(config); // config is null on timeout → falls back to bubble
    })
    .catch(function () {
      // API error → fallback to bubble
      console.warn("[MuseWidget] Config fetch failed — loading default bubble");
      window.__museBubbleInit();
    });
  }

  // Run on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootstrap);
  } else {
    bootstrap();
  }

})();
// =============================================================================
// END BOOTSTRAP — existing chat bubble code above is completely unchanged
// =============================================================================




