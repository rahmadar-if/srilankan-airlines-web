                        position: fixed !important;
                        top: 0 !important;
                        left: 0 !important;
                        width: 100% !important;
                        height: 100% !important;
                        z-index: 2147483647 !important;
                        pointer-events: none !important;
                        transform: none !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        border: none !important;
