        const ua = navigator.userAgent || "";
        // Check for generic mobile tokens OR specific Samsung Fold model numbers (SM-F...)
        const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Samsung|SM-F|Fold/i.test(ua);

        return isMobileUA;
