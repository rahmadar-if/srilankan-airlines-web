                shadowRoot.appendChild(tooltipStyleElement);
            }
            tooltipStyleElement.textContent = '.header-button .tooltip { display: none !important; }';

            // Header background color (inline fallback for immediate effect)
            const chatHeader = shadowRoot.getElementById('chat-header');
            if (chatHeader) {
                chatHeader.style.background = headerBackColor;
                chatHeader.style.backgroundColor = headerBackColor;
            }

            // Header text color (inline fallback for immediate effect)
            const chatTitle = chatHeader ? chatHeader.querySelector('.chat-title') : null;
            if (chatTitle) {
                chatTitle.style.color = headerTextColor;
                chatTitle.textContent = widgetHeader;
            }

            // 3. Header SVG icon fill (collapse, more, close, expand)
            const headerControls = chatHeader ? chatHeader.querySelector('.header-controls') : null;
            const headerControlIcons = headerControls ? headerControls.querySelectorAll('svg') : [];
            headerControlIcons.forEach(svg => {
                svg.querySelectorAll('path').forEach(path => {
                    path.setAttribute('fill', headerTextColor);
                });
                svg.removeAttribute('style'); // Remove other styling
            });

            // Function to check if chat bubble icon is displayed and loaded
            const checkIconDisplayed = (callback) => {
                if (chatBubbleEl.style.display === 'flex') {
                    const iconElement = chatBubbleEl.querySelector('img') || chatBubbleEl.querySelector('svg');
                    if (iconElement) {
                        if (iconElement.tagName === 'IMG') {
                            // For custom icon, wait for image load
                            if (iconElement.complete) {
                                callback();
                            } else {
                                iconElement.addEventListener('load', callback);
                                iconElement.addEventListener('error', () => {
                                    console.error('Chat bubble icon failed to load');
                                });
                            }
                        } else {
                            // For SVG, assume it's loaded since it's inline
                            callback();
                        }
                    }
                }
            };


            // Handle tooltip display with delay and icon load check
            const existingTooltipContainer = chatBubbleEl.querySelector('.tooltip-container');
            if (existingTooltipContainer) {
                existingTooltipContainer.remove();
            }

            if (tooltip === true && widgetEnabled) {
                // Create tooltip container with arrow and message
                const tooltipContainer = document.createElement('div');
                tooltipContainer.className = 'tooltip-container';
                tooltipContainer.style.display = 'none'; // Initially hidden

                const tooltipArrow = document.createElement('div');
                tooltipArrow.className = 'tooltip-arrow';
                tooltipArrow.style.display = 'none'; // Initially hidden
                tooltipArrow.style.opacity = '0'; // Ensure opacity sync
                tooltipArrow.style.transition = 'opacity 0.3s ease'; // Add fade-in transition

                const tooltipMessage = document.createElement('div');
                tooltipMessage.className = 'tooltip-message';
                tooltipMessage.style.display = 'none'; // Initially hidden
                tooltipMessage.style.opacity = '0'; // Start with opacity 0 for fade-in
                tooltipMessage.style.transition = 'opacity 0.3s ease'; // Add fade-in transition

                tooltipContainer.appendChild(tooltipArrow);
                tooltipContainer.appendChild(tooltipMessage);
                chatBubbleEl.appendChild(tooltipContainer);

                debugLog("Tooltip container created and appended to chat bubble");

                // Display all tooltip components simultaneously after icon is confirmed displayed
                checkIconDisplayed(() => {
                    setTimeout(() => {
                        if (tooltipContainer && tooltipArrow && tooltipMessage && chatBubbleEl.style.display === 'flex') {
                            const messages = chatBubbleTip.split(',').map(msg => msg.trim()).filter(msg => msg !== '');
                            if (messages.length > 0) {
                                // Show all components at once
                                tooltipContainer.style.display = 'flex';
                                tooltipArrow.style.display = 'block';
                                tooltipMessage.style.display = 'flex';

                                // Apply fade-in effect simultaneously
                                setTimeout(() => {
                                    tooltipArrow.style.opacity = '1';
                                    tooltipMessage.style.opacity = '1';
                                }, 10); // Small delay to ensure transition applies

                                if (staticChatBubbleTipEnabled) {
                                    // Show only the first message for static tooltip
                                    tooltipMessage.textContent = messages[0];
                                } else {
                                    // Cycle through all messages for non-static tooltip
                                    let currentIndex = 0;
                                    const displayNextMessage = () => {
                                        tooltipMessage.textContent = messages[currentIndex];
                                        tooltipMessage.style.opacity = '0'; // Reset opacity for fade-in
                                        tooltipArrow.style.opacity = '0'; // Reset arrow opacity for sync
                                        setTimeout(() => {
                                            tooltipArrow.style.opacity = '1'; // Fade in arrow
                                            tooltipMessage.style.opacity = '1'; // Fade in message
                                        }, 10); // Small delay to ensure transition applies
                                        currentIndex = (currentIndex + 1) % messages.length; // Loop back to start
                                        window._liaTooltipTimeout = setTimeout(displayNextMessage, 3000); // 3 seconds delay
                                    };
                                    displayNextMessage();
                                }

                                // Auto-dismiss: tooltipPersistent=true keeps it visible forever;
                                // tooltipDismissAfter=N fades out after N seconds
                                const dismissSecs = parseFloat(tooltipDismissAfter);
                                if (!tooltipPersistent && !isNaN(dismissSecs) && dismissSecs > 0) {
                                    window._liaTooltipDismissTimeout = setTimeout(() => {
                                        if (window._liaTooltipTimeout) {
                                            clearTimeout(window._liaTooltipTimeout);
                                            window._liaTooltipTimeout = null;
                                        }
                                        tooltipMessage.style.opacity = '0';
                                        tooltipArrow.style.opacity = '0';
                                        setTimeout(() => {
                                            tooltipContainer.style.display = 'none';
                                            tooltipArrow.style.display = 'none';
                                            tooltipMessage.style.display = 'none';
                                        }, 300);
                                    }, dismissSecs * 1000);
                                }
                            } else {
                                // No valid messages, hide all tooltip components
                                tooltipContainer.style.display = 'none';
                                tooltipArrow.style.display = 'none';
                                tooltipMessage.style.display = 'none';
                                tooltipMessage.textContent = '';
                            }
                        }
                    }, 500); // 500ms delay after icon is confirmed loaded
                });
            } else {
                // Hide and remove tooltip components if tooltip is false or widget is disabled
                if (window._liaTooltipTimeout) {
                    clearTimeout(window._liaTooltipTimeout);
                    window._liaTooltipTimeout = null;
                }
                if (window._liaTooltipDismissTimeout) {
                    clearTimeout(window._liaTooltipDismissTimeout);
                    window._liaTooltipDismissTimeout = null;
                }

                const tooltipContainer = chatBubbleEl.querySelector('.tooltip-container');
                if (tooltipContainer) {
                    tooltipContainer.remove();
                }
            }

            // Pop out time for bubble icon animation
            if (chatBubble) {
                if (animation === true) {
                    chatBubble.style.animationName = 'popInOut';
