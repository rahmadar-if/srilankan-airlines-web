                            if (!window.visualViewport || !lastKnownKeyboardState) return;
                            const recheckVh = window.visualViewport.height;
                            if (Math.abs(recheckVh - finalVh) > 10) {
                                debugLog(`📏 Keyboard re-sync (first-load fix): ${finalVh}px → ${recheckVh}px`);
                                chatContainer.style.height = `${recheckVh}px`;
                                iframe.style.height = `${recheckVh}px`;
                                void chatContainer.offsetHeight;
                                void iframe.offsetHeight;
                                triggerIframeResize();
