    // Collapse icon (arrows pointing inward)
    COLLAPSE: `<path d="M160 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 64-64 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l96 0c17.7 0 32-14.3 32-32l0-96zM32 320c-17.7 0-32 14.3-32 32s14.3 32 32 32l64 0 0 64c0 17.7 14.3 32 32 32s32-14.3 32-32l0-96c0-17.7-14.3-32-32-32l-96 0zM352 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 96c0 17.7 14.3 32 32 32l96 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-64 0 0-64zM320 320c-17.7 0-32 14.3-32 32l0 96c0 17.7 14.3 32 32 32s32-14.3 32-32l0-64 64 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-96 0z"/>`,

    // More icon (three dots)
    MORE: `<path d="M64 360a56 56 0 1 0 0 112 56 56 0 1 0 0-112zm0-160a56 56 0 1 0 0 112 56 56 0 1 0 0-112zM120 96A56 56 0 1 0 8 96a56 56 0 1 0 112 0z"/>`,

    // Close icon (X)
    CLOSE: `<path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"/>`,

    // Default brand logo
    BRAND_LOGO: `<path d="M29.7499 35.8096C29.4236 36.8286 29.0231 37.6775 28.5507 38.3542C24.0661 46.4024 17.1751 46.5385 17.1751 46.5385C35.2155 52.951 37.3777 36.9508 41.5539 23.9175C41.5539 23.9175 41.5539 23.9175 41.5519 23.9175C37.5318 22.6442 33.2414 24.8685 31.9581 28.8845L29.7479 35.8096H29.7499ZM2.06169 15.6751C-4.34883 33.7175 11.6475 35.8777 24.6807 40.0539C25.95 36.0178 23.6937 31.7214 19.6516 30.4802C15.3813 29.1688 10.7485 27.6533 9.81359 26.7163C9.94772 26.8325 10.0919 26.9426 10.244 27.0507C2.19583 22.5681 2.06169 15.6751 2.06169 15.6751ZM15.7416 4.16938C12.5023 7.37064 9.78155 19.5871 8.10585 23.9635H8.10785C12.1319 25.2388 16.4243 22.9945 17.6756 18.9644C18.9849 14.7421 20.4824 10.1695 21.2693 9.31261C21.2152 9.38269 21.1611 9.45476 21.1091 9.52883C25.5957 1.47864 32.4887 1.3445 32.4887 1.3445C26.8129 -0.69958 19.8898 -0.885769 15.7416 4.17138V4.16938ZM19.4674 10.7881V10.7841C19.4674 10.7841 19.4674 10.7861 19.4654 10.7881H19.4674ZM30.2604 16.546C39.0053 19.3588 47.9564 23.5011 48.0285 31.5272C51.486 22.9925 48.3989 13.8673 38.7891 11.4188L25.4095 7.14841C24.1522 11.0844 26.3284 15.2807 30.2604 16.546ZM38.8552 19.3408C38.8552 19.3408 38.8512 19.3348 38.8471 19.3368C38.8471 19.3368 38.8498 19.3382 38.8552 19.3408Z" fill="white"/>`
};

// Function to get current Flutter app build hash
function getCurrentFlutterBuildHash() {
    try {
        // Check if we're in an iframe (widget embedded in another site)
        if (window !== window.top) {
            // Try to get from parent window if available
            return window.parent?.__BUILD_CONFIG__?.BUILD_HASH || 'unknown';
        } else {
            // Direct access to Flutter app
            return window.__BUILD_CONFIG__?.BUILD_HASH || 'unknown';
        }
    } catch (error) {
        debugLog('Error getting Flutter build hash:', error);
        return 'unknown';
    }
}

// ============================================================================
// 🔍 DEBUG CONFIGURATION
// ============================================================================
// IMPORTANT: Set DEBUG_MODE = true to see detailed device dimension logs
// This will show comprehensive information about:
// - Screen resolution (physical device resolution)
// - Window viewport (browser window size)
// - Document dimensions (rendered page size)
// - Visual viewport (visible area, useful for keyboard tracking)
// - Breakpoint detection (which screen size category is active)
// - Resize events (track changes between standard/multiview modes)
// - Style override detection and enforcement logs
//
// MOBILE_DEBUG_OVERLAY = true will show logs on screen (useful for mobile testing)
// ============================================================================
const DEBUG_MODE = false; // Set to TRUE to enable console logs
const MOBILE_DEBUG_OVERLAY = false; // Set to TRUE to show debug overlay on screen for mobile testing

// IMMEDIATE LOG - This will ALWAYS show (not dependent on DEBUG_MODE)
console.log('%c🚀 [CHAT-WIDGET] Script loaded!', 'background: #222; color: #bada55; font-size: 14px; padding: 5px;');
console.log('[CHAT-WIDGET] DEBUG_MODE:', DEBUG_MODE, 'Time:', new Date().toISOString());

// Create debug overlay for mobile testing
let debugOverlay = null;
let debugMessages = [];
const MAX_DEBUG_MESSAGES = 25;

function createDebugOverlay() {
    if (!MOBILE_DEBUG_OVERLAY || debugOverlay) return;

    debugOverlay = document.createElement('div');
    debugOverlay.id = 'mobile-debug-overlay';
    debugOverlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        max-height: 800px;
        overflow-y: auto;
        background: rgba(0, 0, 0, 0.85);
        color: #0f0;
        font-family: monospace;
        font-size: 10px;
        padding: 5px;
        z-index: 999999;
        pointer-events: auto;
        line-height: 1.2;
        white-space: pre-wrap;
        word-break: break-all;
    `;
    document.body.appendChild(debugOverlay);
}

function updateDebugOverlay(message) {
    if (!MOBILE_DEBUG_OVERLAY) return;

    if (!debugOverlay) {
        createDebugOverlay();
    }

    const timestamp = new Date().toLocaleTimeString('en-US', {
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        fractionalSecondDigits: 3
    });

    debugMessages.push(`[${timestamp}] ${message}`);

    // Keep only last N messages
    if (debugMessages.length > MAX_DEBUG_MESSAGES) {
        debugMessages.shift();
    }

    debugOverlay.textContent = debugMessages.join('\n');

    // Auto-scroll to bottom
    debugOverlay.scrollTop = debugOverlay.scrollHeight;
}

// Replace all console.log statements with this function
const debugLog = (...args) => {
    if (DEBUG_MODE) {
        const message = args.map(arg =>
            typeof arg === 'object' ? JSON.stringify(arg) : String(arg)
        ).join(' ');

        console.log(...args);
        updateDebugOverlay(message);
    }
};

// Function to check URL parameters for force cache clear
function shouldForceCacheClear() {
    try {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('forceCacheClear') === 'true' ||
            urlParams.get('clearCache') === 'true' ||
            urlParams.get('refresh') === 'force';
    } catch (error) {
        debugLog('Error checking URL parameters:', error);
        return false;
    }
}

// Function to check for build hash changes (minor version updates)
function shouldClearForBuildUpdate() {
    try {
        const storedBuildHash = getEncryptedStorage(localStorage, STORAGE_KEYS.BUILD_HASH);
        const currentFlutterBuildHash = getCurrentFlutterBuildHash();

        // Skip check if we can't get current Flutter hash
        if (currentFlutterBuildHash === 'unknown') {
            debugLog('Cannot determine Flutter build hash, skipping build update check');
            return false;
        }

        // If no stored hash or if build hash changed, clear cache
        if (!storedBuildHash || storedBuildHash !== currentFlutterBuildHash) {
            debugLog('Flutter build hash changed or missing:', {
                stored: storedBuildHash,
                current: currentFlutterBuildHash
            });
            return true;
        }

        return false;
    } catch (error) {
        debugLog('Error checking Flutter build hash:', error);
        return true; // Clear cache on error to be safe
    }
}

// Function to update build hash in storage
function updateStoredBuildHash() {
    try {
        const currentFlutterBuildHash = getCurrentFlutterBuildHash();
        if (currentFlutterBuildHash !== 'unknown') {
            setEncryptedStorage(localStorage, STORAGE_KEYS.BUILD_HASH, currentFlutterBuildHash);
            debugLog('Updated stored build hash to:', currentFlutterBuildHash);
        } else {
            debugLog('Cannot update build hash - Flutter hash unknown');
        }
    } catch (error) {
        debugLog('Error updating build hash:', error);
    }
}

//encryption/decryption functions using Base64 and character shifting(XOR cipher)
let ENCRYPTION_KEY = '';
let resolveEncryptionKeyPromise;
const encryptionKeyPromise = new Promise(resolve => {
    resolveEncryptionKeyPromise = resolve;
});

function encrypt(text, key = ENCRYPTION_KEY) {
    if (typeof text !== 'string') {
        text = JSON.stringify(text);
    }

    let result = '';
    for (let i = 0; i < text.length; i++) {
        const charCode = text.charCodeAt(i);
        const keyChar = key.charCodeAt(i % key.length);
        result += String.fromCharCode(charCode ^ keyChar);
    }

    // Base64 encode the result for safe storage
    return btoa(result);
}

function decrypt(encryptedText, key = ENCRYPTION_KEY) {
    try {
        // Base64 decode first
        const decoded = atob(encryptedText);

        let result = '';
        for (let i = 0; i < decoded.length; i++) {
            const charCode = decoded.charCodeAt(i);
            const keyChar = key.charCodeAt(i % key.length);
            result += String.fromCharCode(charCode ^ keyChar);
        }

        return result;
    } catch (error) {
        debugLog('Decryption error:', error);
        return null;
    }
}

function encryptStorageKey(key) {
    return 'enc_' + encrypt(key);
}

function decryptStorageKey(encryptedKey) {
    if (!encryptedKey.startsWith('enc_')) {
        return null;
    }
    return decrypt(encryptedKey.substring(4));
}

// Enhanced storage functions that encrypt both keys and values
function setEncryptedStorage(storage, key, value) {
    try {
        const encryptedKey = encryptStorageKey(key);
        const encryptedValue = encrypt(value);
        storage.setItem(encryptedKey, encryptedValue);
        return true;
    } catch (error) {
        debugLog('Error setting encrypted storage:', error);
        return false;
    }
}

function getEncryptedStorage(storage, key) {
    try {
        const encryptedKey = encryptStorageKey(key);
        const encryptedValue = storage.getItem(encryptedKey);

        if (!encryptedValue) {
            return null;
        }

        return decrypt(encryptedValue);
    } catch (error) {
        debugLog('Error getting encrypted storage:', error);
        return null;
    }
}

function removeEncryptedStorage(storage, key) {
    try {
        const encryptedKey = encryptStorageKey(key);
        storage.removeItem(encryptedKey);
        return true;
    } catch (error) {
        debugLog('Error removing encrypted storage:', error);
        return false;
    }
}


function storeCredentials(credentials) {
    try {
        setEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS, JSON.stringify(credentials));
        if (credentials.tenant) {
            setEncryptedStorage(localStorage, STORAGE_KEYS.TENANT_ID, credentials.tenant);
        }
        // Store current cache version, build hash, and last access time
        setEncryptedStorage(localStorage, STORAGE_KEYS.CACHE_VERSION, CURRENT_CACHE_VERSION);
        updateStoredBuildHash(); // Use the Flutter app's build hash
        setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS, Date.now().toString());

        // Backup to sessionStorage for cache clearing protection
        backupToSessionStorage();

        debugLog('Credentials stored successfully with sessionStorage backup');

        // After storing credentials, also store the current parent URL
        const currentParentUrl = window.location.href;
        setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL, currentParentUrl);
        setEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL, currentParentUrl);
        debugLog('Stored current parent URL with credentials:', currentParentUrl);
    } catch (error) {
        console.error('Error storing credentials:', error);
    }
}

// new function to get the lastly stored parent URL
function getLastStoredParentUrl() {
    try {
        // First check localStorage
        let lastStoredUrl = getEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL);

        // If not found in localStorage, check sessionStorage
        if (!lastStoredUrl) {
            lastStoredUrl = getEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL);
        }

        // If still not found, use current URL as fallback
        if (!lastStoredUrl) {
            lastStoredUrl = window.location.href;
            debugLog('No stored parent URL found, using current URL as fallback:', lastStoredUrl);
        } else {
            debugLog('Found lastly stored parent URL:', lastStoredUrl);
        }

        return lastStoredUrl;
    } catch (error) {
        console.error('Error getting lastly stored parent URL:', error);
        return window.location.href; // Fallback to current URL
    }
}

// Function to detect if browser cache was cleared
function detectCacheClearing() {
    try {
        // Create a test key to check if localStorage is working
        const testKey = 'lia_chat_test_key';
        const testValue = Date.now().toString();

        // Try to set and get a test value
        setEncryptedStorage(localStorage, testKey, testValue);
        const retrievedValue = getEncryptedStorage(localStorage, testKey);

        // Clean up test key
        removeEncryptedStorage(localStorage, testKey);

        // If we can't retrieve the value we just set, localStorage might be cleared
        if (retrievedValue !== testValue) {
            debugLog('Detected localStorage access issues, likely due to cache clearing');
            return true;
        }

        // Additional check: verify that our expected storage keys are accessible
        const expectedKeys = [STORAGE_KEYS.CACHE_VERSION, STORAGE_KEYS.LAST_ACCESS];
        for (const key of expectedKeys) {
            try {
                const value = getEncryptedStorage(localStorage, key);
                // If the key exists but we can't read it properly, it might indicate cache issues
                if (value === null && key !== STORAGE_KEYS.USER_CREDENTIALS) {
                    // This is expected for credentials if user is not logged in
                    continue;
                }
            } catch (error) {
                debugLog(`Error accessing localStorage key ${key}:`, error);
                return true;
            }
        }

        return false;
    } catch (error) {
        debugLog('Error testing localStorage access:', error);
        return true; // Assume cache was cleared if we can't access localStorage
    }
}

// Function to backup critical data to sessionStorage as a fallback
function backupToSessionStorage() {
    try {
        const credentials = getEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS);
        const cacheVersion = getEncryptedStorage(localStorage, STORAGE_KEYS.CACHE_VERSION);
        const buildHash = getEncryptedStorage(localStorage, STORAGE_KEYS.BUILD_HASH);
        const lastAccess = getEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS);
        const lastParentUrl = getEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL);

        if (credentials) {
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.USER_CREDENTIALS, credentials);
        }
        if (cacheVersion) {
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.CACHE_VERSION, cacheVersion);
        }
        if (buildHash) {
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.BUILD_HASH, buildHash);
        }
        if (lastAccess) {
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_ACCESS, lastAccess);
        }
        if (lastParentUrl) {
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL, lastParentUrl);
        }
    } catch (error) {
        debugLog('Error backing up to sessionStorage:', error);
    }
}

// Function to restore from sessionStorage if localStorage is cleared
function restoreFromSessionStorage() {
    try {
        const credentials = getEncryptedStorage(sessionStorage, STORAGE_KEYS.USER_CREDENTIALS);
        const cacheVersion = getEncryptedStorage(sessionStorage, STORAGE_KEYS.CACHE_VERSION);
        const buildHash = getEncryptedStorage(sessionStorage, STORAGE_KEYS.BUILD_HASH);
        const lastAccess = getEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_ACCESS);
        const lastParentUrl = getEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL);

        if (credentials && cacheVersion && lastAccess) {
            setEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS, credentials);
            setEncryptedStorage(localStorage, STORAGE_KEYS.CACHE_VERSION, cacheVersion);
            setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS, lastAccess);

            // Restore build hash if available, otherwise use current Flutter hash
            if (buildHash) {
                setEncryptedStorage(localStorage, STORAGE_KEYS.BUILD_HASH, buildHash);
            } else {
                updateStoredBuildHash(); // Use current Flutter app's build hash
            }

            if (lastParentUrl) {
                setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL, lastParentUrl);
            }

            // Clean up sessionStorage
            removeEncryptedStorage(sessionStorage, STORAGE_KEYS.USER_CREDENTIALS);
            removeEncryptedStorage(sessionStorage, STORAGE_KEYS.CACHE_VERSION);
            removeEncryptedStorage(sessionStorage, STORAGE_KEYS.BUILD_HASH);
            removeEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_ACCESS);
            removeEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL);

            debugLog('Restored credentials from sessionStorage');
            return true;
        }

        return false;
    } catch (error) {
        debugLog('Error restoring from sessionStorage:', error);
        return false;
    }
}

function getStoredCredentials() {
    try {
        // Check if force cache clear is requested via URL parameters
        if (shouldForceCacheClear()) {
            debugLog('Force cache clear requested via URL parameters. Clearing stored credentials.');
            clearStoredCredentials();
            // Clean up URL parameters after clearing
            const url = new URL(window.location);
            url.searchParams.delete('forceCacheClear');
            url.searchParams.delete('clearCache');
            url.searchParams.delete('refresh');
            window.history.replaceState({}, document.title, url.toString());
            return null;
        }

        // Check for build hash changes (minor version updates)
        if (shouldClearForBuildUpdate()) {
            debugLog('Build hash change detected. Clearing stored credentials for minor update.');
            clearStoredCredentials();
            return null;
        }

        // First check if localStorage is accessible and working
        if (detectCacheClearing()) {
            debugLog('Cache clearing detected, attempting to restore from sessionStorage');

            // Try to restore from sessionStorage before clearing
            if (restoreFromSessionStorage()) {
                debugLog('Successfully restored credentials from sessionStorage');
                // Continue with normal flow after restoration
            } else {
                debugLog('No backup found in sessionStorage, clearing stored credentials');
                clearStoredCredentials();
                return null;
            }
        }

        // Check if credentials exist first
        const credentials = getEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS);
        if (!credentials) {
            return null;
        }

        // Check if cache version exists and matches
        const storedCacheVersion = getEncryptedStorage(localStorage, STORAGE_KEYS.CACHE_VERSION);
        const lastAccess = getEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS);

        // Only clear credentials if:
        // 1. Cache version doesn't exist (first time or cache was cleared)
        // 2. Cache version doesn't match (app was updated)
        // 3. Last access time doesn't exist (cache was cleared)
        if (!storedCacheVersion || storedCacheVersion !== CURRENT_CACHE_VERSION || !lastAccess) {
            debugLog('Cache version mismatch or missing last access detected. Clearing stored credentials.');
            clearStoredCredentials();
            return null;
        }

        // Update last access time to indicate the credentials are still valid
        setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS, Date.now().toString());

        // Backup to sessionStorage for future cache clearing events
        backupToSessionStorage();

        return JSON.parse(credentials);
    } catch (error) {
        console.error('Error retrieving credentials:', error);
        // Only clear credentials if there's an actual error reading localStorage
        // This might indicate cache was cleared or storage is unavailable
        if (error.name === 'QuotaExceededError' || error.name === 'SecurityError') {
            clearStoredCredentials();
        }
        return null;
    }
}

function clearStoredCredentials() {
    try {
        removeEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS);
        removeEncryptedStorage(localStorage, STORAGE_KEYS.TENANT_ID);
        removeEncryptedStorage(localStorage, STORAGE_KEYS.CACHE_VERSION);
        removeEncryptedStorage(localStorage, STORAGE_KEYS.BUILD_HASH);
        removeEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS);
        removeEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL);

        // Also clear sessionStorage backup
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.USER_CREDENTIALS);
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.CACHE_VERSION);
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.BUILD_HASH);
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_ACCESS);
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL);

        debugLog('Stored credentials cleared from both localStorage and sessionStorage');
    } catch (error) {
        console.error('Error clearing credentials:', error);
    }
}

// Function to store navigation state
function storeNavigationState(navigationPath) {
    try {
        setEncryptedStorage(localStorage, STORAGE_KEYS.NAVIGATION_STATE, navigationPath);
        // Also backup to sessionStorage for cache clearing protection
        setEncryptedStorage(sessionStorage, STORAGE_KEYS.NAVIGATION_STATE, navigationPath);
        debugLog('Navigation state stored successfully:', navigationPath);
    } catch (error) {
        console.error('Error storing navigation state:', error);
    }
}

// Function to get stored navigation state
function getStoredNavigationState() {
    try {
        // First check if localStorage is accessible and working
        if (detectCacheClearing()) {
            debugLog('Cache clearing detected, attempting to restore navigation state from sessionStorage');

            // Try to restore from sessionStorage before clearing
            const sessionNavState = getEncryptedStorage(sessionStorage, STORAGE_KEYS.NAVIGATION_STATE);
            if (sessionNavState) {
                setEncryptedStorage(localStorage, STORAGE_KEYS.NAVIGATION_STATE, sessionNavState);
                debugLog('Successfully restored navigation state from sessionStorage');
                return sessionNavState;
            } else {
                debugLog('No navigation state backup found in sessionStorage');
                return null;
            }
        }

        const navigationState = getEncryptedStorage(localStorage, STORAGE_KEYS.NAVIGATION_STATE);
        if (navigationState) {
            debugLog('Found stored navigation state:', navigationState);
            return navigationState;
        }

        return null;
    } catch (error) {
        console.error('Error getting navigation state:', error);
        return null;
    }
}

// Function to clear navigation state
function clearNavigationState() {
    try {
        removeEncryptedStorage(localStorage, STORAGE_KEYS.NAVIGATION_STATE);
        removeEncryptedStorage(sessionStorage, STORAGE_KEYS.NAVIGATION_STATE);
        debugLog('Navigation state cleared from both localStorage and sessionStorage');
    } catch (error) {
        console.error('Error clearing navigation state:', error);
    }
}

async function initChatWidget() {
    const initialWindowHeight = window.innerHeight;
    let prevToken = getEncryptedStorage(localStorage, STORAGE_KEYS.AUTH_TOKEN);
    let animationTimeout = null;
    const topOffset = 60; // default fallback
    let collapsedWidthOffset = 0;
    let collapsedHeightOffset = topOffset;
    let expandedWidthOffset = 0;
    let expandedHeightOffset = topOffset;
    let defaultPosition = {
        bottom: '15px',
        right: '15px'
    };
    let bubbleIconWidth = 50;
    let bubbleIconHeight = 50;
    let tooltip = false;
    let defaultView = "expanded";
    let animation = false;

    // Find the script tag that loaded this file, falling back to query selector if currentScript is unavailable
    const scriptTag = document.currentScript || document.querySelector('script[src*="chat-widget.js"]');
    const scriptUrl = scriptTag ? scriptTag.src : '';

    // Parse query parameters from the script URL
    const urlParams = new URLSearchParams(scriptUrl.split('?')[1] || '');
    debugLog("Extracted Query Parameters:", Object.fromEntries(urlParams));

    // Log window.chatParams
    const windowParams = window.chatParams || {};
    debugLog("Extracted window.chatParams:", windowParams);

    // Get the base URL from data-flutter-base-url attribute
    const flutterBaseUrl = scriptTag.dataset.flutterBaseUrl || window.chatParams?.flutterBaseUrl;

    const hasQueryParams = scriptUrl.includes('?') && urlParams.toString() !== '';
    const hasWindowParams = Object.keys(windowParams).length > 0;

    let config = {};
    if (!hasQueryParams && !hasWindowParams) {
        console.error("No query parameters or window.chatParams provided, and tenant is required. Aborting initialization.");
        return; // NEW: Abort if no parameters and no tenant
    } else {
        // List of parameters to extract from query params or windowParams
        const paramKeys = [
            { key: 'tenant', windowKey: 'tenant' },
            { key: 'theme', windowKey: 'theme_configs.mode', defaultValue: 'light' }, // Updated to handle theme_configs.mode
            { key: 'primaryColour', windowKey: 'primaryColor' },
            { key: 'secondaryColour', windowKey: 'secondaryColor' },
            { key: 'canvas', windowKey: 'canvas.side', transform: (value) => ({ side: value }) },
            { key: 'streaming', windowKey: 'streaming.isEnabled', transform: (value) => ({ isEnabled: value }) },
            { key: 'filters', windowKey: 'filters.isEnabled', transform: (value) => ({ isEnabled: value }) },
            { key: 'top_bar_configs', windowKey: 'top_bar_configs.isVisible', transform: (value) => ({ isVisible: value === 'true' || value === true }), urlKey: 'top_bar_configs' },
            { key: 'side_bar_configs', windowKey: 'side_bar_configs.isEnabled', transform: (value) => ({ isEnabled: value === 'true' || value === true }), urlKey: 'side_bar_configs' },
            { key: 'authToken', windowKey: 'authToken' },

        ];

        // Start with window.chatParams as the base config
        config = { ...windowParams }; // NEW: Use all windowParams properties

        // Merge query parameters, prioritizing URL params for defined keys
        paramKeys.forEach(({ key, windowKey, transform, urlKey, defaultValue }) => {
            const urlValue = urlKey ? urlParams.get(urlKey) : urlParams.get(key);
            const windowValue = windowKey.includes('.')
                ? windowKey.split('.').reduce((obj, k) => obj && obj[k], windowParams)
                : windowParams[windowKey];

            if (urlValue) {
                if (windowValue) {
                    console.warn(`Conflict for parameter '${key}': urlParams=${urlValue}, windowParams=${windowValue}. Using urlParams value.`);
                }
                config[key] = transform ? transform(urlValue) : urlValue;
            } else if (windowValue !== undefined) {
                config[key] = transform ? transform(windowValue) : windowValue;
            } else if (defaultValue !== undefined) {
                config[key] = defaultValue;
            } else {
                config[key] = null;
            }
        });

        // Ensure theme is a valid string ("light" or "dark")
        if (config.theme && typeof config.theme === 'string') {
            config.theme = config.theme.toLowerCase();
            if (config.theme !== 'light' && config.theme !== 'dark') {
                console.warn(`Invalid theme value '${config.theme}'. Defaulting to 'light'.`);
                config.theme = 'light';
            }
        } else {
            console.warn(`Theme is not a valid string. Defaulting to 'light'.`);
            config.theme = 'light';
        }

        // Add flutterBaseUrl if provided
        if (flutterBaseUrl) {
            config.flutterBaseUrl = flutterBaseUrl;
        }

        //Derive tenant from tenant_id if tenant is not provided
        if (!config.tenant && config.tenant_id) {
            config.tenant = config.tenant_id;
            debugLog(`Using tenant_id '${config.tenant_id}' as tenant since tenant parameter is not provided.`);
        }

        // Check for tenant
        if (!config.tenant) {
            console.error("Tenant parameter is required but not provided in query parameters, window.chatParams, or tenant_id. Aborting initialization.");
            return;
        }

        debugLog("Merged configuration:", config);
    }

    // Construct query string from params for the iframe source URL (unchanged)
    const queryString = Object.keys(config)
        .map(key => {
            if (key === 'canvas' && config[key]?.side) {
                return `canvasSide=${encodeURIComponent(config[key].side)}`;
            } else if (key === 'streaming' && config[key]?.isEnabled) {
                return `streaming=${encodeURIComponent(config[key].isEnabled)}`;
            } else if (key === 'filters' && config[key]?.isEnabled) {
                return `filters=${encodeURIComponent(config[key].isEnabled)}`;
            } else if (key === 'side_bar_configs' && config[key]?.isEnabled !== undefined) {
                return `side_bar_configs=${encodeURIComponent(config[key].isEnabled)}`;
            } else if (key === 'chatWidgetIcon' && config[key]) {
                return `chat-widget-icon-url=${encodeURIComponent(config[key])}`;
            } else if (key === 'top_bar_configs' && config[key]?.isVisible !== undefined) {
                return `top_bar_configs=${encodeURIComponent(config[key].isVisible)}`;
            } else if (['tenant', 'theme', 'primaryColour', 'secondaryColour', 'authToken'].includes(key) && config[key]) {
                return `${key}=${encodeURIComponent(config[key])}`;
            }
            return '';
        })
        .filter(Boolean)
        .join('&');

    // Define the iframe source URL with optional query parameters
    const iframeSrc = `${flutterBaseUrl}${queryString ? `?${queryString}` : ''}`;



    // Create a container with Shadow DOM
    const widgetContainer = document.createElement('div');
    widgetContainer.id = 'chat-widget-wrapper';
    // Apply maximum z-index to the container itself for extra protection
    // CRITICAL: Use CSS text to apply styles that can't be overridden by parent page
    widgetContainer.style.cssText = `
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 2147483647 !important;
        pointer-events: none !important;
        transform: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        background: transparent !important;
    `;
    const shadowRoot = widgetContainer.attachShadow({ mode: 'open' });


    // HTML template for the chat widget including iframe and controls
    const widgetHTML = `
        <div id="chat-widget-container">
            <div id="chat-iframe-container" class="hidden">
                <div id="chat-header">
                    <div class="header-content">
                        <button id="header-chat-bubble" class="header-chat-bubble"></button>
                        <div class="chat-title"></div>
                    </div>
                    <div class="header-controls">
                        <button id="expand-chat" class="header-button">
                            <svg class="expand-icon header-icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                ${SVG_ICONS.EXPAND}
                            </svg>
                        </button>
                        <button id="more-chat" class="header-button">
                            <svg class="more-icon header-icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 512">${SVG_ICONS.MORE}</svg>
                            <div class="dropdown hidden">
                                <div class="dropdown-item" id="new-chat">New Chat</div>
                                <div class="dropdown-item" id="restart-chat">Restart Chat</div>

                            </div>
                        </button>
                        <button id="close-chat" class="header-button">
                            <svg class="close-icon header-icon-fill" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
                                ${SVG_ICONS.CLOSE}
                            </svg>
                        </button>
                    </div>
                </div>
                <!-- Resize handles for North, West, and Northwest directions only -->
                <div class="resize-handle resize-top" data-direction="n"></div>
                <div class="resize-handle resize-left" data-direction="w"></div>
                <div class="resize-handle resize-top-left" data-direction="nw"></div>
                <iframe id="chat-iframe" src="${iframeSrc}" sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation allow-forms allow-downloads" frameborder="0" allow="geolocation; microphone; camera; clipboard-write; clipboard-read"></iframe>
                <div id="iframe-overlay" class="iframe-overlay hidden"></div>
            </div>
            <button id="floating-chat-bubble" class="floating-chat-bubble">
                <!-- Tooltip container will be dynamically added when API response is received -->
            </button>
        </div>
    `;
    shadowRoot.innerHTML = widgetHTML;

    // Function to send configuration to the iframe
    const sendConfigToIframe = () => {
        debugLog("Sending setConfig to iframe:", config);
        try {
            iframe.contentWindow.postMessage({ type: "setConfig", config: config }, "*");
        } catch (e) {
            debugLog("Error sending config to iframe:", e);
        }
    };

    // Function to send parent URL to the iframe
    const sendParentUrlToIframe = (url) => {
        debugLog("Sending parent URL to iframe:", url);
        try {
            iframe.contentWindow.postMessage({ type: "setParentUrl", url: url }, "*");
            // Always update both localStorage and sessionStorage when sending a new URL
            setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_PARENT_URL, url);
            setEncryptedStorage(sessionStorage, STORAGE_KEYS.LAST_PARENT_URL, url);
            debugLog("Updated stored parent URL:", url);
        } catch (e) {
            debugLog("Error sending parent URL to iframe:", e);
        }
    };

    // // Handle authToken comparison and storage
    if (config.authToken) {
        const prevToken = getEncryptedStorage(localStorage, STORAGE_KEYS.AUTH_TOKEN);
        debugLog('[ChatWidget] Previous Token:', prevToken);
        debugLog('[ChatWidget] New Token:', config.authToken);
        if (prevToken !== config.authToken) {
            debugLog('[ChatWidget] Token changed, storing new token');
            setEncryptedStorage(localStorage, STORAGE_KEYS.AUTH_TOKEN, config.authToken);
            backupToSessionStorage(); // Backup to sessionStorage
        }
    }

    // Function to send refreshToken to the iframe
    const sendRefreshTokenToIframe = (token) => {
        debugLog('[ChatWidget] Sending refreshToken to iframe:', token);
        try {
            iframe.contentWindow.postMessage({
                type: 'refreshToken',
                refreshToken: token
            }, '*');
        } catch (e) {
            console.error('[ChatWidget] Error sending refreshToken to iframe:', e);
        }
    };

    // On initialization (initial load or refresh)
    let previousParentUrl = getEncryptedStorage(sessionStorage, 'lia_chat_last_parent_url');
    let currentParentUrl = window.location.href;

    if (previousParentUrl !== currentParentUrl) {
        debugLog("[ChatWidget] [initial load/refresh] Sending parent URL to iframe:", currentParentUrl);
        sendParentUrlToIframe(currentParentUrl);
        setEncryptedStorage(sessionStorage, 'lia_chat_last_parent_url', currentParentUrl);
    }

    // In your SPA polling interval
    setInterval(() => {
        const newParentUrl = window.location.href;
        const storedUrl = getEncryptedStorage(sessionStorage, 'lia_chat_last_parent_url');
        if (newParentUrl !== storedUrl) {
            debugLog("[ChatWidget] [SPA navigation] Detected URL change from", storedUrl, "to", newParentUrl);
            sendParentUrlToIframe(newParentUrl);
            setEncryptedStorage(sessionStorage, 'lia_chat_last_parent_url', newParentUrl);
        }
    }, 1000);


    // Handle 'flutterReady' message to send config only once when Flutter app is ready
    let isFlutterReady = false;
    window.addEventListener('message', (event) => {
        if (event.data && event.data.type === "setCredentials") {
            debugLog("Received credentials to store:", event.data.credentials);
            storeCredentials(event.data.credentials);

            // Re-enable new chat button when credentials are set
            if (newChatBtn.disabled) {
                newChatBtn.disabled = false;
                newChatBtn.classList.remove('disabled');
                newChatBtn.style.opacity = '1';
                newChatBtn.style.cursor = 'pointer';
                newChatBtn.style.backgroundColor = '';
                //                debugLog("New chat button re-enabled - user has logged in");
            }
        } else if (event.data && event.data.type === "clearCredentials") {
            debugLog("Clearing stored credentials");
            clearStoredCredentials();

            // Don't disable new chat button here - let the login status determine the state
            // The button will be disabled when user is actually on login screen
        } else if (event.data && event.data.type === "checkCredentialsExist") {
            debugLog("Checking if credentials exist");
            const storedCredentials = getStoredCredentials();
            const exists = storedCredentials !== null;
            debugLog("Credentials exist:", exists);
            iframe.contentWindow.postMessage({
                type: "credentialsExistResponse",
                exists: exists
            }, "*");
        }
        else if (event.data && event.data.type === 'setEncryptionKey') {
            ENCRYPTION_KEY = event.data.encryptionKey || ENCRYPTION_KEY;
            debugLog('Received encryption key from Flutter:', ENCRYPTION_KEY);
            // NEW: Resolve the promise with the received key
            resolveEncryptionKeyPromise(ENCRYPTION_KEY);
        }
        else if (event.data && event.data.type === "storeNavigationState") {
            debugLog("Received navigation state to store:", event.data.navigationPath);
            storeNavigationState(event.data.navigationPath);
        } else if (event.data && event.data.type === "getNavigationState") {
            debugLog("Checking if navigation state exists");
            const storedNavigationState = getStoredNavigationState();
            debugLog("Navigation state exists:", storedNavigationState !== null);
            iframe.contentWindow.postMessage({
                type: "navigationStateResponse",
                navigationPath: storedNavigationState
            }, "*");
        } else if (event.data && event.data.type === "clearNavigationState") {
            debugLog("Clearing stored navigation state");
            clearNavigationState();
        } else if (event.data && event.data.type === "flutterReady") {
            debugLog("Received flutterReady at:", new Date().toISOString());
            if (!isFlutterReady) {
                isFlutterReady = true;
                debugLog("Sending configuration to Flutter:", config);

                // Check for stored credentials and send them if they exist
                const storedCredentials = getStoredCredentials();
                if (storedCredentials) {
                    debugLog("Found stored credentials, sending to Flutter");
                    iframe.contentWindow.postMessage({
                        type: "restoreCredentials",
                        credentials: storedCredentials
                    }, "*");

                    // Ensure new chat button is enabled if credentials exist
                    newChatBtn.disabled = false;
                    newChatBtn.classList.remove('disabled');
                    newChatBtn.style.opacity = '1';
                    newChatBtn.style.cursor = 'pointer';
                    newChatBtn.style.backgroundColor = '';
                    //                    debugLog("New chat button enabled - credentials found");
                } else {
                    // Don't disable new chat button based on credentials alone
                    // Let the actual login status determine the button state
                    debugLog("No stored credentials found, but not disabling new chat button");
                }

                // Check for stored navigation state and send it if it exists
                const storedNavigationState = getStoredNavigationState();
                if (storedNavigationState) {
                    debugLog("Found stored navigation state, sending to Flutter:", storedNavigationState);
                    iframe.contentWindow.postMessage({
                        type: "restoreNavigationState",
                        navigationPath: storedNavigationState
                    }, "*");
                }

                sendConfigToIframe();
                if (previousParentUrl !== currentParentUrl) {
                    debugLog("[ChatWidget] [flutterReady event] Sending parent URL to iframe:", currentParentUrl);
                    sendParentUrlToIframe(currentParentUrl);
                }

                // Send refreshToken if authToken exists and has changed
                if (config.authToken) {
                    if (prevToken !== config.authToken) {
                        sendRefreshTokenToIframe(config.authToken);
                    }
                }
            }
        }
        else if (event.data && event.data.type === "getLastStoredParentUrl") {
            debugLog("Received request for lastly stored parent URL");
            const lastStoredUrl = getLastStoredParentUrl();
            debugLog("Sending lastly stored parent URL to iframe:", lastStoredUrl);
            iframe.contentWindow.postMessage({
                type: "lastStoredParentUrlResponse",
                url: lastStoredUrl
            }, "*");
        } else if (event.data && event.data.type === 'restartChatCompleted') {
            debugLog("Received restartChatCompleted message from Flutter");
            // Re-enable restart button
            const restartBtn = shadowRoot.getElementById('restart-chat');
            if (restartBtn) {
                restartBtn.disabled = false;
                restartBtn.style.opacity = '1';
            }
        } else if (event.data && event.data.type === 'newChatStarted') {
            debugLog("Received newChatStarted message from Flutter");
            // Re-enable new chat button
            const newChatBtn = shadowRoot.getElementById('new-chat');
            if (newChatBtn) {
                newChatBtn.disabled = false;
                newChatBtn.classList.remove('disabled');
                newChatBtn.style.opacity = '1';
                newChatBtn.style.cursor = 'pointer';
                newChatBtn.style.backgroundColor = '';
                //                debugLog("New chat button re-enabled - new chat started");
            }
        } else if (event.data && event.data.type === 'userLoggedIn') {
            debugLog("User logged in - enabling new chat button");
            // Enable new chat button when user is logged in
            newChatBtn.disabled = false;
            newChatBtn.classList.remove('disabled');
            newChatBtn.style.opacity = '1';
            newChatBtn.style.cursor = 'pointer';

            newChatBtn.style.backgroundColor = '';
        } else if (event.data && event.data.type === 'userLoggedOut') {
            debugLog("User logged out - disabling new chat button");
            // Disable new chat button when user is logged out
            newChatBtn.disabled = true;
            newChatBtn.classList.add('disabled');
            newChatBtn.style.opacity = '0.5';
            newChatBtn.style.cursor = 'not-allowed';
            newChatBtn.style.color = '#999';
            // Remove any existing hover styles to let CSS take over
            newChatBtn.style.backgroundColor = '';
        } else if (event.data && event.data.type === 'updateChatBubbleConfig') {
            const chatBubbleConfigsRaw = event.data.chatBubbleConfigs || {};
            debugLog('Received chat bubble configs from Dart:', chatBubbleConfigsRaw);
            // Helper to handle undefined, null, or empty string
            function withDefault(val, def) {
                return (val === undefined || val === null || val === "") ? def : val;
            }
            // Set defaults for each value, giving priority to chatBubbleConfigsRaw
            const headerBackColor = withDefault(chatBubbleConfigsRaw.headerBackColor, "#41689b");
            const headerTextColor = withDefault(chatBubbleConfigsRaw.headerTextColor, "#ffffff");
            const welcomeGradientStart = withDefault(chatBubbleConfigsRaw.welcomeGradientStart, "#17355D");
            const welcomeGradientEnd = withDefault(chatBubbleConfigsRaw.welcomeGradientEnd, "#346DB9");
            const welcomeStartChatBG = withDefault(chatBubbleConfigsRaw.welcomeStartChatBG, "#A3CDFF2E");
            const welcomeStartChatArrowBG = withDefault(chatBubbleConfigsRaw.welcomeStartChatArrowBG, "#17355DCF");
            const useGradient = withDefault(chatBubbleConfigsRaw.useGradient, true);
            const widgetHeader = withDefault(chatBubbleConfigsRaw.widgetHeader, "Chat with Lia");
            const chatBubbleTip = withDefault(chatBubbleConfigsRaw.chatBubbleTip, "Welcome!");
            const staticChatBubbleTipEnabled = withDefault(chatBubbleConfigsRaw.staticChatBubbleTipEnabled, false);
            const tooltip = withDefault(chatBubbleConfigsRaw.tooltip, false);
            // Fall back to bootstrap API config for tooltip fields Flutter may not send
            var _ttApi = window.__liaTooltipApiCfg || {};
            const tooltipPersistent = withDefault(chatBubbleConfigsRaw.tooltipPersistent, withDefault(_ttApi.tooltipPersistent, false));
            const tooltipDismissAfter = withDefault(chatBubbleConfigsRaw.tooltipDismissAfter, withDefault(_ttApi.tooltipDismissAfter, 5));
            const welcomeText = withDefault(chatBubbleConfigsRaw.welcomeText, "#FFF");
            const popOutTime = withDefault(chatBubbleConfigsRaw.popOutTime, 2);
            const autoOpenEnabled = withDefault(chatBubbleConfigsRaw.autoOpenEnabled, false);
            const widgetEnabled = withDefault(chatBubbleConfigsRaw.widgetEnabled, true);
            const bubbleBottom = withDefault(chatBubbleConfigsRaw.bubbleBottom, '15px');
            const bubbleRight = withDefault(chatBubbleConfigsRaw.bubbleRight, '15px');
            const chatWidgetIconUrl = withDefault(chatBubbleConfigsRaw.chatWidgetIconUrl, "");
            collapsedWidthOffset = parseInt(withDefault(chatBubbleConfigsRaw.collapsedWidthOffset, window.innerWidth * 0.75), 10);
            collapsedHeightOffset = parseInt(withDefault(chatBubbleConfigsRaw.collapsedHeightOffset, topOffset), 10);
            expandedWidthOffset = parseInt(withDefault(chatBubbleConfigsRaw.expandedWidthOffset, 0), 10);
            expandedHeightOffset = parseInt(withDefault(chatBubbleConfigsRaw.expandedHeightOffset, topOffset), 10);
            defaultView = withDefault(chatBubbleConfigsRaw.defaultView, "expanded");
            animation = withDefault(chatBubbleConfigsRaw.animation, true);
            const rawWidth = chatBubbleConfigsRaw.bubbleIconWidth;
            const rawHeight = chatBubbleConfigsRaw.bubbleIconHeight;

            // Update defaultPosition with API values
            defaultPosition = {
                bottom: typeof bubbleBottom === 'number' ? `${bubbleBottom}px` : bubbleBottom,
                right: typeof bubbleRight === 'number' ? `${bubbleRight}px` : bubbleRight
            };
            const chatBubble = shadowRoot.getElementById('floating-chat-bubble');
            if (chatBubble) {
                chatBubble.style.right = defaultPosition.right;
                chatBubble.style.bottom = defaultPosition.bottom;
                chatBubble.style.left = 'auto';
                chatBubble.style.top = 'auto';
            }


            // Only update if values are provided in the config
            if (rawWidth !== undefined && rawWidth !== null) {
                const parsedWidth = parseInt(rawWidth);
                if (!isNaN(parsedWidth) && parsedWidth >= 40 && parsedWidth <= 150) {
                    bubbleIconWidth = parsedWidth;
                } else {
                    console.warn(`Invalid bubbleIconWidth '${rawWidth}'. Using default value 50.`);
                    bubbleIconWidth = 50;
                }
            }

            if (rawHeight !== undefined && rawHeight !== null) {
                const parsedHeight = parseInt(rawHeight);
                if (!isNaN(parsedHeight) && parsedHeight >= 40 && parsedHeight <= 150) {
                    bubbleIconHeight = parsedHeight;
                } else {
                    console.warn(`Invalid bubbleIconHeight '${rawHeight}'. Using default value 50.`);
                    bubbleIconHeight = 50;
                }
            }

            // Update chat bubble icon size
            const chatBubbleIcon = shadowRoot.getElementById('floating-chat-bubble');
            if (chatBubbleIcon) {
                chatBubbleIcon.style.width = `${bubbleIconWidth}px`;
                chatBubbleIcon.style.height = `${bubbleIconHeight}px`;

                // Also update the img or svg inside if present
                const iconElement = chatBubbleIcon.querySelector('img, svg');
                if (iconElement) {
                    iconElement.style.width = `${bubbleIconWidth}px`;
                    iconElement.style.height = `${bubbleIconHeight}px`;
                }
            }

            // Update chat bubble and header bubble icons based on API response
            const headerBubble = shadowRoot.getElementById('header-chat-bubble');
            if (chatWidgetIconUrl) {
                debugLog("Setting custom chat icon from API:", chatWidgetIconUrl);
                chatBubble.classList.add('custom-icon');
                headerBubble.classList.add('custom-icon');

                // Update both container and image dimensions
                chatBubble.style.width = `${bubbleIconWidth}px`;
                chatBubble.style.height = `${bubbleIconHeight}px`;

                chatBubble.innerHTML = `<img src="${chatWidgetIconUrl}" style="width: 100%; height: 100%;">`;
                headerBubble.innerHTML = `<img src="${chatWidgetIconUrl}" style="width: 30px; height: 30px;" >`;
            } else {
                debugLog("Setting default SVG chat icon from API response");
                chatBubble.classList.remove('custom-icon');
                headerBubble.classList.remove('custom-icon');
                chatBubble.innerHTML = `
                    <svg width="50" height="48" viewBox="0 0 50 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        ${SVG_ICONS.BRAND_LOGO}
                    </svg>
                `;
                headerBubble.innerHTML = `
                    <svg width="50" height="48" viewBox="0 0 45 43" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M29.7499 35.8096C29.4236 36.8286 29.0231 37.6775 28.5507 38.3542C24.0661 46.4024 17.1751 46.5385 17.1751 46.5385C35.2155 52.951 37.3777 36.9508 41.5539 23.9175C41.5539 23.9175 41.5539 23.9175 41.5519 23.9175C37.5318 22.6442 33.2414 24.8685 31.9581 28.8845L29.7479 35.8096H29.7499ZM2.06169 15.6751C-4.34883 33.7175 11.6475 35.8777 24.6807 40.0539C25.95 36.0178 23.6937 31.7214 19.6516 30.4802C15.3813 29.1688 10.7485 27.6533 9.81359 26.7163C9.94772 26.8325 10.0919 26.9426 10.244 27.0507C2.19583 22.5681 2.06169 15.6751 2.06169 15.6751ZM15.7416 4.16938C12.5023 7.37064 9.78155 19.5871 8.10585 23.9635H8.10785C12.1319 25.2388 16.4243 22.9945 17.6756 18.9644C18.9849 14.7421 20.4824 10.1695 21.2693 9.31261C21.2152 9.38269 21.1611 9.45476 21.1091 9.52883C25.5957 1.47864 32.4887 1.3445 32.4887 1.3445C26.8129 -0.69958 19.8898 -0.885769 15.7416 4.17138V4.16938ZM19.4674 10.7881V10.7841C19.4674 10.7841 19.4674 10.7861 19.4654 10.7881H19.4674ZM30.2604 16.546C39.0053 19.3588 47.9564 23.5011 48.0285 31.5272C51.486 22.9925 48.3989 13.8673 38.7891 11.4188L25.4095 7.14841C24.1522 11.0844 26.3284 15.2807 30.2604 16.546ZM38.8552 19.3408C38.8552 19.3408 38.8512 19.3348 38.8471 19.3368C38.8471 19.3368 38.8498 19.3382 38.8552 19.3408Z" fill="white"/>
                    </svg>
                `;
            }

