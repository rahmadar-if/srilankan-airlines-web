                                iframe.contentWindow.postMessage({
                                    type: 'keyboardOpened',
                                    viewportHeight: finalVh
                                }, '*');
                                debugLog('📤 Notified Flutter: keyboardOpened, viewportHeight:', finalVh);
                            } catch (e) {
                                debugLog('Error notifying Flutter of keyboardOpened:', e);
                            }
                        }

