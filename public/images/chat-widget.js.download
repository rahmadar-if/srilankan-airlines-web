            pointer-events: auto;
            cursor: default;
        }
        .iframe-overlay.hidden {
            display: none;
            pointer-events: none;
        }
        .hidden {
            display: none !important;
        }
         .resize-handle {
            position: absolute;
            pointer-events: auto;
            z-index: 2147483644;
            background: transparent;
        }

        /* North edge handle */
        .resize-top {
            top: 0;
            left: 8px;
            right: 8px;
            height: 4px;
            cursor: ns-resize;
        }

        /* West edge handle */
        .resize-left {
            width: 12px;
            left: 0;
            top: 8px;
            bottom: 8px;
            cursor: ew-resize;
            position: absolute;
            z-index: 2147483644;
            background: transparent;
        }

        /* Northwest corner handle */
        .resize-top-left {
            top: 0;
            left: 0;
            width: 12px;             /* Slightly larger to avoid edge flicker */
            height: 12px;
            cursor: nw-resize;
            pointer-events: auto;
            background: transparent;
            z-index: 2147483643;
        }
        #chat-iframe-container:hover #resize-handle {
            visibility: visible;
        }
        .resize-icon {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.8);
            user-select: none;
            transform: rotate(180deg);
        }
        .resize-hidden {
            visibility: hidden;
        }
        .tooltip {
            visibility: hidden;
            width: 100px;
            background-color: black;
            color: white;
            font-size: 14px;
            text-align: left; /* Align tooltip text to the left */
            border-radius: 4px;
            padding: 8px 16px;
            position: absolute;
           z-index: 2147483642;
            top: 30px;
            left: 50%;
            transform: translateX(-80%);
            display: flex;
            align-items: center;
            justify-content: flex-start; /* Align content to the left */
            font-family: 'Inter', sans-serif;
        }
            #resize-handle:hover .tooltip {
            visibility: visible;
            left: 20%;
            transform: translateX(-10%);
            transform: translateY(-60%);
        }
        .header-button:hover .tooltip,
        #resize-handle:hover .tooltip {
            visibility: visible;
        }
        #more-chat:hover .tooltip {
            visibility: visible;
        }
        #more-chat .dropdown:not(.hidden) ~ .tooltip {
            visibility: hidden;
        }
        #expand-chat.expanded .tooltip {
            content: "Collapse";
        }
        .dropdown
        {
            position: absolute;
            width: 130px;
            top: 30px;
            right: 0;
            background-color: white;
            border-radius: 4px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 2147483641;
            display: flex;
            flex-direction: column;
            text-align: left; /* Align items to the left */
        }
        .dropdown-item {
            padding: 8px 16px 8px 12px; /* Adjusted padding: 8px top/bottom, 12px left, 16px right */
            color: black;
            cursor: pointer;
            font-size: 14px;
            transition: opacity 0.3s ease;
        }
        .dropdown-item:hover {
            background-color: black;
            color: white !important;
        }
        /* Enabled state - when opacity is 1 (not disabled) */
        .dropdown-item[style*="opacity: 1"] {
            color: black !important;
            cursor: pointer !important;
        }
        /* Hover effect for enabled state */
        .dropdown-item[style*="opacity: 1"]:hover {
            background-color: black;
            color: white !important;
        }

        .dropdown-item:disabled {
            color: #999 !important;
            cursor: not-allowed !important;
            opacity: 0.5 !important;
        }
        .dropdown-item:disabled:hover {
            background-color: black !important;
            color: white !important;
        }
        /* Additional disabled state for elements with disabled attribute */
        .dropdown-item[disabled] {
            color: #999 !important;
            cursor: not-allowed !important;
            opacity: 0.5 !important;
        }
        .dropdown-item[disabled]:hover {
            background-color: black !important;
            color: white !important;
        }
        /* Disabled class styling for better control */
        .dropdown-item.disabled {
            color: #999 !important;
            cursor: not-allowed !important;
            opacity: 0.5 !important;
        }
        .dropdown-item.disabled:hover {
            background-color: black !important;
            color: white !important;
        }
        /* Mobile: < 400px - Full screen, chat only (no split) */
        @media (max-width: 400px) {
            #chat-iframe-container {
                position: fixed;
                width: 100vw;
                height: 100dvh;
                min-height: 100dvh;
                max-height: 100dvh;
                top: 0;
                bottom: 0;
                right: 0;
                left: 0;
                margin: 0;
                padding: 0;
                border-radius: 0;
                transform: none;
            }
            .floating-chat-bubble {
                width: ${bubbleIconWidth}px !important;
                height: ${bubbleIconHeight}px !important;
                inset: auto 10px 10px auto !important;
            }
            .floating-chat-bubble span {
                font-size: 25px;
            }
            .tooltip-container {
                display: none !important;
            }
            /* Hide resize handles on mobile */
            .resize-handle {
                display: none !important;
            }
        }
        /* Mobile Large (Foldable): 400-600px - Full screen, 1:1 split (SPLIT SCREEN STARTS) */
        @media (min-width: 400px) and (max-width: 600px) {
            #chat-iframe-container {
                position: fixed;
                width: 100vw;
                height: 100dvh;
                min-height: 100dvh;
                max-height: 100dvh;
                top: 0;
                bottom: 0;
                right: 0;
                left: 0;
                margin: 0;
                padding: 0;
                border-radius: 0;
                transform: none;
            }
            .floating-chat-bubble {
                width: ${bubbleIconWidth}px;
                height: ${bubbleIconHeight}px;
            }
            .floating-chat-bubble span {
                font-size: 26px;
            }
            /* Hide resize handles on foldable devices */
            .resize-handle {
                display: none !important;
            }
        }
        /* Tablet: 600-1000px - Full screen, 1:1 split */
        @media (min-width: 600px) and (max-width: 1000px) {
            #chat-iframe-container {
                position: fixed;
                width: 100vw;
                height: 100dvh;
                min-height: 100dvh;
                max-height: 100dvh;
                top: 0;
                bottom: 0;
                right: 0;
                left: 0;
                margin: 0;
                padding: 0;
                border-radius: 0;
                transform: none;
            }
            .floating-chat-bubble {
                width: ${bubbleIconWidth}px;
                height: ${bubbleIconHeight}px;
            }
            .floating-chat-bubble span {
                font-size: 28px;
            }
            /* Hide resize handles on tablet */
            .resize-handle {
                display: none !important;
            }
        }
        /* Desktop: 1000-1400px - Adjustable width, resizable */
        @media (min-width: 1000px) and (max-width: 1400px) {
            #chat-iframe-container:not(.expanded) {
                width: 30vw;
                /* Height set by JavaScript on open to prevent keyboard resize */
                bottom: 0;
                right: 0;
                margin: 0;
            }
        }
        /* Large Desktop: > 1400px - Adjustable width, resizable */
        @media (min-width: 1400px) {
            #chat-iframe-container:not(.expanded) {
                width: 30vw;
                /* Height set by JavaScript on open to prevent keyboard resize */
                bottom: 0;
                right: 0;
                margin: 0;
            }
        }
        #chat-iframe-container.expanded {
            position: fixed!important;
            right: 0!important;
            /* Height set by JavaScript on open to prevent keyboard resize */
            bottom: 0!important;
            margin: 0!important;
            box-sizing: border-box;
        }

