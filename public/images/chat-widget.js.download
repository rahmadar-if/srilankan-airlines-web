        if (event.key === STORAGE_KEYS.USER_CREDENTIALS ||
            event.key === STORAGE_KEYS.CACHE_VERSION ||
            event.key === STORAGE_KEYS.LAST_ACCESS ||
            event.key === STORAGE_KEYS.AUTH_TOKEN) {

            debugLog('Storage event detected:', event);

            // If the new value is null, it means the item was removed (cache cleared)
            if (event.newValue === null) {
                debugLog('Detected localStorage item removal, likely due to cache clearing');
                // Don't clear credentials here, let getStoredCredentials handle it
                // This is just for logging and monitoring
            }
        }
    });

    // Add beforeunload event listener to detect page refresh/reload
    window.addEventListener('beforeunload', () => {
        // Update last access time before page unload to maintain session continuity
        try {
            const storedCredentials = getEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS);
            if (storedCredentials) {
                setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS, Date.now().toString());
            }
        } catch (error) {
            debugLog('Error updating last access time on beforeunload:', error);
        }
    });

    // Add visibility change listener to detect when page becomes visible again
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) {
            // Page became visible again, check if credentials are still valid
            try {
                const storedCredentials = getEncryptedStorage(localStorage, STORAGE_KEYS.USER_CREDENTIALS);
                if (storedCredentials) {
                    // Update last access time to indicate the page is active
                    setEncryptedStorage(localStorage, STORAGE_KEYS.LAST_ACCESS, Date.now().toString());
                }
            } catch (error) {
                debugLog('Error updating last access time on visibility change:', error);
            }
        }
    });

    // On page unload, store the current URL in sessionStorage
    window.addEventListener('beforeunload', () => {
