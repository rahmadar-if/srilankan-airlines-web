        // When "Multi View" is on OR "Desktop Site" is requested:
        // - Width reports huge (e.g. 980px - 1400px)
        // - UA says "Macintosh" or "Windows"
        // BUT it still has a massive Pixel Ratio (usually 2.6 - 3.5) AND Touch.
        // real desktops *can* have high DPR (Retina), but usually don't have touch.
        // Surface/Touch Laptops have touch, but usually lower DPR (1.25 - 1.5) or report specific Windows touch UAs.
        // We set the bar at 2.0 to be safe for modern phones (usually 2.6+).
        const isHighDensity = window.devicePixelRatio >= 2.0;
        if (hasTouch && isHighDensity) {
            return true;
        }

