    AUTH_TOKEN: 'lia_chat_auth_token',
    NAVIGATION_STATE: 'lia_chat_navigation_state',
    LAST_PARENT_URL: 'lia_chat_last_parent_url'
};

// Cache version to detect when browser cache is cleared
const CURRENT_CACHE_VERSION = '1.0.0';

// SVG Icon Constants - Reusable across the widget
const SVG_ICONS = {
