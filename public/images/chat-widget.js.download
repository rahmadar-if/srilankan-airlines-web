                        const finalVh = window.visualViewport.height;
                        chatContainer.style.height = `${finalVh}px`;
                        iframe.style.height = `${finalVh}px`;
                        void chatContainer.offsetHeight;
                        void iframe.offsetHeight;
                        debugLog(`📏 Keyboard final sync: iframe → ${finalVh}px`);

