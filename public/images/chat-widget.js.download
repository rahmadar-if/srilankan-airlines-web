                                    chatContainer.style.height = `${viewportHeight}px`;
                                    chatContainer.style.top = '0px';
                                    chatContainer.style.bottom = 'auto';
                                    chatContainer.style.minHeight = '0px';
                                    chatContainer.style.maxHeight = 'none';
                                }
                                // Note: monitoring will be activated when input is focused
                            }
                        } else {
                            isExpanded = defaultView === 'expanded';
                            const expandIcon = expandBtn.querySelector('.expand-icon');

                            // Call updateChatContainerSize to apply the correct view dimensions
                            updateChatContainerSize(isExpanded);

                            // Update expand/collapse icon
                            if (expandIcon) {
                                if (isExpanded) {
                                    expandIcon.innerHTML = SVG_ICONS.COLLAPSE;
                                } else {
                                    expandIcon.innerHTML = SVG_ICONS.EXPAND;
                                }
                            }
                        }

                        // Ensure position and layout are set (only for desktop)
                        if (!dimensions.isMobileDevice) {
                            chatContainer.style.position = 'fixed';
                            chatContainer.style.bottom = '0';
                            chatContainer.style.top = 'auto';
                            chatContainer.style.margin = '0';
                            chatContainer.style.right = '0';
                            chatContainer.style.left = 'auto';
                        }
                        // On mobile, CSS handles everything
                        chatBubble.style.display = 'none';



                        debugLog(`Iframe auto-opened after ${popOutTime} seconds in ${defaultView} view`);
                    }
                }, popOutTime * 1000);
            }
            // Now add tooltip container after chat bubble icon is set
            if (tooltip === true) {
                // Create tooltip container with arrow and message
                const tooltipContainer = document.createElement('div');
                tooltipContainer.className = 'tooltip-container';
                tooltipContainer.style.display = 'none'; // Initially hidden

                const tooltipArrow = document.createElement('div');
                tooltipArrow.className = 'tooltip-arrow';
                tooltipArrow.style.display = 'none'; // Initially hidden

                const tooltipMessage = document.createElement('div');
                tooltipMessage.className = 'tooltip-message';
                tooltipMessage.style.display = 'none'; // Initially hidden

                tooltipContainer.appendChild(tooltipArrow);
                tooltipContainer.appendChild(tooltipMessage);
                chatBubble.appendChild(tooltipContainer);

                debugLog("Tooltip container added to chat bubble");

                // Add delay before showing tooltip components
                setTimeout(() => {
                    if (tooltipContainer && tooltipArrow && tooltipMessage) {
                        tooltipContainer.style.display = 'flex';
                        tooltipArrow.style.display = 'block';
                        debugLog("Tooltip components displayed after delay");
                    }
                }, 500); // 500ms delay after chat bubble icon is set
            }

            // Update defaultView and other configs
            defaultView = withDefault(chatBubbleConfigsRaw.defaultView, "expanded");
            if (defaultView !== "expanded" && defaultView !== "collapsed") {
                console.warn(`Invalid defaultView value '${defaultView}'. Defaulting to 'expanded'.`);
                defaultView = "expanded";
            }
            // Update isExpanded to match defaultView
            isExpanded = defaultView === "expanded";

            // Use existing chatBubble variable if available, otherwise get it
            var chatBubbleEl = shadowRoot.getElementById('floating-chat-bubble');
            if (!widgetEnabled) {
                if (chatBubbleEl) chatBubbleEl.style.display = 'none';
                return;
            } else {
                if (chatBubbleEl) chatBubbleEl.style.display = 'flex';
            }

            // Set CSS variables for header background and text color
            document.documentElement.style.setProperty('--lia-header-bg', headerBackColor);
            document.documentElement.style.setProperty('--lia-header-color', headerTextColor);

            // Set CSS variables for tooltip-message background and color
            if (welcomeGradientStart && welcomeGradientEnd && useGradient === true) {
                document.documentElement.style.setProperty('--lia-tooltip-bg', `linear-gradient(90deg, ${welcomeGradientStart}, ${welcomeGradientEnd})`);
            } else if (welcomeStartChatBG) {
                document.documentElement.style.setProperty('--lia-tooltip-bg', welcomeStartChatBG);
            }
            document.documentElement.style.setProperty('--lia-tooltip-color', welcomeText);
            document.documentElement.style.setProperty('--lia-tooltip-arrow-bg', welcomeStartChatArrowBG);

            // Hide header button tooltips (removed feature)
