        allStyleSheets.forEach((sheet, index) => {
            try {
                const rules = Array.from(sheet.cssRules || []);
                rules.forEach(rule => {
                    if (rule.style) {
                        const text = rule.cssText.toLowerCase();
                        // Check for rules that might affect fixed positioning
                        if ((text.includes('position') && text.includes('fixed')) ||
                            text.includes('transform') ||
                            (text.includes('*') && text.includes('position'))) {
                            suspiciousRules.push({
                                sheet: index,
                                selector: rule.selectorText,
                                cssText: rule.cssText
