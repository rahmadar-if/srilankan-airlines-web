            // Unlock parent scroll when widget closes
            if (window.unlockParentScroll) {
                window.unlockParentScroll();
            }

            // Show the chat bubble when container is closed
            chatBubble.style.display = 'flex';

            // Notify Flutter app that widget is closed
            try {
                iframe.contentWindow.postMessage({
                    type: 'widgetStateChanged',
                    isOpen: false
