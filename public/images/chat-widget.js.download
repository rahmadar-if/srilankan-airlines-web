                // Mimic mobile dimensions for narrow desktop windows
                collapsedWidth = visualViewPortWidth;
                expandedWidth = visualViewPortWidth;
                collapsedHeight = visualViewPortHeight;
                expandedHeight = visualViewPortHeight;

                // Hide expand button as we are effectively full screen
                const expandBtn = shadowRoot.getElementById('expand-chat');
                if (expandBtn) {
                    expandBtn.style.display = 'none';
                }
            } else {
                // Regular Desktop / Tablet Mode
                debugLog('Standard Desktop mode (> 600px)');

                // Show expand/collapse button
                const expandBtn = shadowRoot.getElementById('expand-chat');
                if (expandBtn) {
                    expandBtn.style.display = 'flex';
                }

                // Calculate collapsed view width based on viewport size
                if (collapsedWidthOffset !== undefined && collapsedWidthOffset !== null) {
                    collapsedWidth = Math.max(currentScreenWidth - collapsedWidthOffset, minWidth);
                } else {
