                if (safeExpandedHeightOffset === undefined || safeExpandedHeightOffset === null || safeExpandedHeightOffset === 0) {
                    safeExpandedHeightOffset = 20; // Default safe margin
                }
                expandedHeight = Math.max(currentScreenHeight - safeExpandedHeightOffset, minHeight);
            }
        }

