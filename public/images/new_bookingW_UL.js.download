function childPlus() {
    allPassengerCount = allPassengerCount + 1;
    var valA = parseInt(document.getElementById("adultCount").innerHTML);
    var valY = parseInt(document.getElementById("yngAdultCount").innerHTML);
    var val = parseInt(document.getElementById("childCount").innerHTML);
    var valI = parseInt(document.getElementById("infantCount").innerHTML);
    if (val == 0)
        $('#cm').removeClass('disabled');
    if (allPassengerCount == 9) {
        $('#ap').addClass('disabled');
        $('#yp').addClass('disabled');
        $('#cp').addClass('disabled');
        document.getElementById("childCount").innerHTML = val + 1;
    }
    else {
        val = val + 1;
        document.getElementById("childCount").innerHTML = val;
        if (valA != 1 && valA > valI)
            $('#am').removeClass('disabled');
        if (valY != 0)
            $('#ym').removeClass('disabled');
        if (val != 0)
            $('#cm').removeClass('disabled');
        if (val == 9)
            $('#cp').addClass('disabled');
        if (valA != valI && valA > valI && valA != 1)
            $('#am').removeClass('disabled');
    }
    if (val == 9) {
        $('#cp').addClass('disabled');
        $('#cm').removeClass('disabled');
    }
}

function infantMinus() {
    var val = parseInt(document.getElementById("infantCount").innerHTML);
    var valA = parseInt(document.getElementById("adultCount").innerHTML);
    if (val - 1 == 0) {
        $('#im').addClass('disabled');
    }
    else {
        $('#ip').removeClass('disabled');
        val = val - 1;
        if (val < valA && valA > 1)
            $('#am').removeClass('disabled');
        document.getElementById("infantCount").innerHTML = val;
    }
}

function infantPlus() {

    var val = parseInt(document.getElementById("infantCount").innerHTML);
    var valA = parseInt(document.getElementById("adultCount").innerHTML);

    if (val + 1 >= valA) {
        $('#ip').addClass('disabled');
        $('#am').addClass('disabled');
        document.getElementById("infantCount").innerHTML = val + 1;
    }
    else {
        $('#im').removeClass('disabled');
        val = val + 1;
        document.getElementById("infantCount").innerHTML = val;
    }
    if (valA > val) {
        $('#im').removeClass('disabled');
    }
    if (valA == 0) {
        $('#im').addClass('disabled');
    }
}

function studentPlus() {

    document.getElementById("adultCount").innerHTML = 0;
    document.getElementById("childCount").innerHTML = 0;
    document.getElementById("yngAdultCount").innerHTML = 0;
    document.getElementById("infantCount").innerHTML = 0;

    allPassengerCount = 1;
    var valS = parseInt(document.getElementById("studentCount").innerHTML);
    valS = valS + 1;

    if (valS == 1) {
        $('#sm').removeClass('disabled');
        $('#sp').addClass('disabled');

        $('#ap').addClass('disabled');
        $('#yp').addClass('disabled');
        $('#cp').addClass('disabled');
        $('#ip').addClass('disabled');

        $('#am').addClass('disabled');
        $('#ym').addClass('disabled');
        $('#cm').addClass('disabled');
        $('#im').addClass('disabled');
        document.getElementById("studentCount").innerHTML = valS;
    }
}

function studentMinus() {

    document.getElementById("adultCount").innerHTML = 0;
    document.getElementById("childCount").innerHTML = 0;
    document.getElementById("yngAdultCount").innerHTML = 0;
    document.getElementById("infantCount").innerHTML = 0;

    allPassengerCount = 0;
    var valS = parseInt(document.getElementById("studentCount").innerHTML);
    valS = 0;

    if (valS == 0) {
        $('#sp').removeClass('disabled');
        $('#sm').addClass('disabled');

        $('#ap').removeClass('disabled');
