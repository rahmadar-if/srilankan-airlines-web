//#region passenger details
var allPassengerCount = parseInt(document.getElementById("adultCount").innerHTML) + parseInt(document.getElementById("yngAdultCount").innerHTML) + parseInt(document.getElementById("childCount").innerHTML);

function adultMinus() {
    allPassengerCount = allPassengerCount - 1;
    var val = parseInt(document.getElementById("adultCount").innerHTML);
    var valI = parseInt(document.getElementById("infantCount").innerHTML);
    val = val - 1;
    if (allPassengerCount == 9)
        $('#ap').removeClass('disabled');
    if (val == 1) {
        $('#am').addClass('disabled');
        $('#ap').removeClass('disabled');
        document.getElementById("adultCount").innerHTML = val;
    }
    if (val == valI) {
        $('#am').addClass('disabled');
        $('#ip').addClass('disabled');
    }
    if (allPassengerCount <= 9) {
        document.getElementById("adultCount").innerHTML = val;

        $('#ap').removeClass('disabled');
        $('#yp').removeClass('disabled');
        $('#cp').removeClass('disabled');
    }
}

function adultPlus() {
    allPassengerCount = allPassengerCount + 1;
    var val = parseInt(document.getElementById("adultCount").innerHTML);
    var valY = parseInt(document.getElementById("yngAdultCount").innerHTML);
    var valC = parseInt(document.getElementById("childCount").innerHTML);
    var valI = parseInt(document.getElementById("infantCount").innerHTML);
    if (val == 1)
        $('#am').removeClass('disabled');
    if (val + 1 > valI) {
        $('#am').removeClass('disabled');
        $('#ip').removeClass('disabled');
    }
    if (allPassengerCount == 9) {
        $('#ap').addClass('disabled');
        $('#yp').addClass('disabled');
        $('#cp').addClass('disabled');
        document.getElementById("adultCount").innerHTML = val + 1;
    }
    else {
        val = val + 1;
        document.getElementById("adultCount").innerHTML = val;
        if (val != 1 && val > valI)
            $('#am').removeClass('disabled');
        if (valY != 0)
            $('#ym').removeClass('disabled');
        if (valC != 0)
            $('#cm').removeClass('disabled');
        if (val > valI)
            $('#ip').removeClass('disabled');
        if (val == 9) {
            $('#ap').addClass('disabled');
        }
    }
}

