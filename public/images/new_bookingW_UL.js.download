function validatePassport() {

    var passportNo = $("#passportNo").val().trim();
    var date = "2026-03-09";
    var origin = $("#seldcity1").val();
    var destination = $("#selacity1").val();
    var flightno = "UL1213";

    $("#btnSearch").addClass("disabled-blur");
    $("#passportError").hide();
    $("#passportValid").hide();

    var path = window.location.pathname;
    var pathParts = path.split("/");
    var langPart = pathParts[1];
    var baseUrl = window.location.origin + "/" + langPart;

    // Append API path
    var apiUrl = baseUrl + "/Corporate/ValidatePassportProxy";

    $.ajax({
        url: apiUrl,
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({
            passportNo: passportNo,
            date: date,
            origin: origin,
            destination: destination,
            flightnumber: flightno
        }),
        success: function (response) {
            console.log(response);

            if (response != "") {
                var data = typeof response === "string" ? JSON.parse(response) : response;

                if (data.responseCode === "1") {
                    $("#passportValid").text(data.responseMessage).css("color", "rgb(21, 61, 138)").show();
                    $("#passportError").hide();
                    $("#btnSearch").removeClass("disabled-blur");

                    setTimeout(function () {
                        $("#romeSpecialFlight").modal('hide');
                    }, 2500);
                } else {
                    $("#passportError").text(data.responseMessage).show();  
                    $("#btnSearch").addClass("disabled-blur");
                }
            }
            else {
                $("#passportError").text("Passenger record not found. Check if you have given passport number").show();
                $("#btnSearch").addClass("disabled-blur");
            }
        },
        error: function () {
            $("#passportError").text("Error validating passport. Please try again.").show();
            $("#passportValid").hide();
            $("#btnSearch").addClass("disabled-blur");
        }
    });
}

function cancelValidatePassport() {
    $("#btnSearch").addClass("disabled-blur");
}

function pageLoaderHide() {
    $('#pgloader').css('display', 'none');
}

function pageLoaderShow() {
    $('#pgloader').css('display', 'flex');
}

function depConfirm(airportCode, airportName) {

    pageLoaderShow();
    setTimeout(pageLoaderHide, 800);
    $("#oriName").show();
    document.getElementById("oriName").innerHTML = (() => {
        let firstPart = airportName.split('-')[0].trim();
        let match = firstPart.match(/\((.*?)\)/);
        return match ? match[1].trim() : firstPart;
    })();
    let result = airportCode;
    if (isReset == false) {
        const codeRT = document.getElementById("oriCode");
        codeRT.innerHTML = result;
        codeRT.style.color = "#153D8A";
        codeRT.style.fontSize = "34px";
        codeRT.style.fontWeight = "bold";
        codeRT.style.paddingTop = "0";
    }
    $('#destinationSearch').val('');
    isReset = false;
}

function desConfirm(airportCode,airportName) {

    pageLoaderShow();
    setTimeout(pageLoaderHide, 800);
    $("#destName").show();
    document.getElementById("destName").innerHTML = (() => {
        let firstPart = airportName.split('-')[0].trim();
        let match = firstPart.match(/\((.*?)\)/);
        return match ? match[1].trim() : firstPart;
    })();
    let result = airportCode;
    if (isReset == false) {
        const codeRT = document.getElementById("destCode");
        codeRT.innerHTML = result;
        codeRT.style.color = "#153D8A";
        codeRT.style.fontSize = "34px";
        codeRT.style.fontWeight = "bold";
        codeRT.style.paddingTop = "0";
        codeRT.style.paddingBottom= "0";
    }
    isReset = false;
}

function dateConfirm() {

    pageLoaderShow();
    setTimeout(pageLoaderHide, 800);
    $("#chatboxid").show();

    if (isChecked) {
        var i = ["January", "February", "March", "April", "May",
            "June", "July", "August", "September", "October",
            "November", "December"];
        var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        var ffDate = firstDay + "/" + (firstMonth + 1) + "/" + firstDate
        var ssDate = secondDay + "/" + (secondMonth + 1) + "/" + secondDate
        $('#selddate1').val(ffDate);
        $('#seladate1').val(ssDate);
        var fd = new Date(ffDate);
        var fdayName = days[fd.getDay()];
        var sd = new Date(ssDate);
        var sdayName = days[sd.getDay()];
        document.getElementById("depatureDate").getElementsByTagName("span")[0].innerHTML = fdayName.substring(0, 3);
        document.getElementById("depatureDate").getElementsByTagName("span")[1].innerHTML = firstDate + " " + i[firstMonth].substring(0, 3);
        document.getElementById("returnDate").getElementsByTagName("span")[0].innerHTML = sdayName.substring(0, 3);;
        document.getElementById("returnDate").getElementsByTagName("span")[1].innerHTML = secondDate + " " + i[secondMonth].substring(0, 3);

    }
    else {
        if (parseInt(owMonth.substring(0, 2)) > 0) {
            
            document.getElementById("depatureDate").getElementsByTagName("span")[0].innerHTML = owDate;
            document.getElementById("depatureDate").getElementsByTagName("span")[1].innerHTML = owMonth;
            var owDepDate = owfirstYear + "/" + (owfirstMonth + 1) + "/" + owfirstDay;
            $('#selddate1').val(owDepDate);
            $('#seladate1').val(owDepDate);
        }
        else {
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            var today = new Date();
            document.getElementById("depatureDate").getElementsByTagName("span")[0] = days[today.getDay()];
            document.getElementById("depatureDate").getElementsByTagName("span")[1].innerHTML = today.getDate() + " " + months[today.getMonth()];
        }
    }
}

function passengerConfirm() {

    debugger;
    pageLoaderShow();
    setTimeout(pageLoaderHide, 800);
    var passengers = parseInt(document.getElementById("adultCount").innerHTML) + parseInt(document.getElementById("childCount").innerHTML) + parseInt(document.getElementById("yngAdultCount").innerHTML);// + parseInt(document.getElementById("studentCount").innerHTML);
    $("#seladults").val(parseInt(document.getElementById("adultCount").innerHTML));
    $("#selchildren").val(parseInt(document.getElementById("childCount").innerHTML));
    $("#selchildrenyoung").val(parseInt(document.getElementById("yngAdultCount").innerHTML));
    $("#selinfants").val(parseInt(document.getElementById("infantCount").innerHTML));
    //$("#selstudent").val(parseInt(document.getElementById("studentCount").innerHTML));

    if (passengers > 1) {
        document.getElementById("passenger").innerHTML = '<b>' + passengers + " " + 'Passengers </b>';
    }
    else {
        document.getElementById("passenger").innerHTML = '<b>' + passengers + " " + 'Passenger </b>';
    }
}

function ClearTextBox(myInput, val) {

    var txtBox = document.getElementById(myInput);
    txtBox.value = "";
    searchDeparts();
    searchDestinations();
    if (val == "dep") {
        $("#icondepSearch").show();
        $("#depx").hide();
        $('#departSearch').focus();
    }
    if (val == "des") {
        $("#icondesSearch").show();
        $("#desx").hide();
        $('#destinationSearch').focus();
    }

    $('#desconbtn').attr('disabled', true);
    $('#depconbtn').attr('disabled', true);
    glbDepatureCountry = "";
    glbDesatureCountry = "";
    return false;
}

function searchDeparts() {

    var input, filter, ul, li, a, i, txtValue;
    input = document.getElementById("departSearch");
    filter = input.value.toUpperCase();
    ul = document.getElementById("depatureAirportList");
    li = ul.getElementsByTagName("li");
    $("#icondepSearch").hide();
    $("#depx").show();
    $('#depconbtn').attr('disabled', true);
    glbDepatureCountry = "";
    for (i = 0; i < li.length; i++) {
        a = li[i].getElementsByTagName("a")[0];
        txtValue = a.textContent || a.innerText;
        if (txtValue.toUpperCase().indexOf(filter) > -1) {
            li[i].style.display = "";
        } else {
            li[i].style.display = "none";
        }
    }
}

function searchDestinations() {

    var input, filter, ul, li, a, i, txtValue;
    input = document.getElementById("destinationSearch");
    filter = input.value.toUpperCase();
    ul = document.getElementById("destinationAirportList");
    li = ul.getElementsByTagName("li");
    $("#icondesSearch").hide();
    $("#desx").show();
    $('#desconbtn').attr('disabled', true);
    glbDesatureCountry = "";
    for (i = 0; i < li.length; i++) {
        a = li[i].getElementsByTagName("a")[0];
        txtValue = a.textContent || a.innerText;
        if (txtValue.toUpperCase().indexOf(filter) > -1) {
            li[i].style.display = "";
        } else {
            li[i].style.display = "none";
        }
    }
}

$('#btnSearch').click(function () {

    if (glbDepatureCountry == "" && $('#oriCode').text() == '') {
        Swal.fire({
            icon: 'error',
            text: 'Please select departing airport',
        })
        return false;
    }
    if (glbDesatureCountry == "" && $('#destCode').text() == '') {
        Swal.fire({
            icon: 'error',
            text: 'Please select destination airport',
        })
        return false;
    }
    var vfrm = $("#suggest1").val();
    var vto = $("#suggest2").val();

    var vclass = $("#selcabinclass").val();

    var radioOnewayOrReturn = isRoundTrip ? 'RETURN' : 'ONEWAY';

    var radioPriceScheduleRedeem = "";

    if ($('input[name=resultby]:checked').val() == '3') {
        radioPriceScheduleRedeem = 'Redeem';
    }
    else if ($('input[name=resultby]:checked').val() == '2') {
        radioPriceScheduleRedeem = 'Price Flow';
    }
    else if ($('input[name=resultby]:checked').val() == '1') {
        radioPriceScheduleRedeem = 'Schedule Flow';
    }
    else {
        radioPriceScheduleRedeem = '';
    }

    var od = vfrm + vto;

    var passengerType = "";

    try {
        passengerType = localStorage.getItem("FFPLoginType");

        if (passengerType == null) {
            passengerType = "UserNotLoggedIn";
        }
    }
    catch (err) {
        passengerType = "UserNotLoggedIn";
    }

    var adultCnt = 0;
    var childCnt = 0;
    var infantCnt = 0;

    var totPsgCnt = 0;

    try {
        totPsgCnt = allPassengerCount;
    }
    catch (err) {
        console.log(err);

        totPsgCnt = 0;
    }

    //SEO new Fix 03-December-2020
    dataLayer.push({
        'event': 'homepage',
        'eventCategory': 'Flight Book',
        'eventAction': radioPriceScheduleRedeem,
        'eventLabel': totPsgCnt,
        'Origin': vfrm,
        'Destination': vto,
        'Class': vclass,
        'Trip Type': radioOnewayOrReturn,
        'O&D': od,
        'Passenger Type': passengerType
    });
});
