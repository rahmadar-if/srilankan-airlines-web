function GoogleAnalytCheckInBookRefTktNo() {
    var bkRef2 = $("#bookref").val();

    var etkt = "";
    if (bkRef2.length > 6) {
        if (bkRef2.match("^603")) {
            //do this if begins with 603 - ticket number
            etkt = bkRef2.replace('603', '');
        }
        else {
            etkt = bkRef2;
        }

        dataLayer.push({
            'event': 'homepage',
            'eventCategory': 'Check-in',
            'eventAction': 'Ticket Number ',
            'eventLabel': etkt
        });
    }
    else {
        dataLayer.push({
            'event': 'homepage',
            'eventCategory': 'Check-in',
            'eventAction': 'Booking Refrence ',
            'eventLabel': bkRef2
        });
    }
}

