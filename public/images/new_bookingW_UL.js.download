function getCurrencyCode(origin) {
    return airportCurrencyMap[origin] || "LKR";
}

var isRoundTrip = true;

function initialMsg(isRoundTrip) {

    var lowFare = localStorage.getItem('lowestFare').toLocaleString();

    if (lowFare) {
        lowFare = Number(lowFare).toLocaleString();
    } else {
        lowFare = 0;
    }

    var currOrg = localStorage.getItem('currencies');
    if (lowFare !== null && lowFare !== undefined && lowFare !== '') {
        if (isRoundTrip) {
            document.getElementById("fareCurrenctCode").innerHTML = "Round-trip fares starting from " + currOrg + " " + lowFare + " per adult";
        }
        else {
            document.getElementById("fareCurrenctCode").innerHTML = "Starting from " + currOrg + " " + lowFare + " per adult";
        }
    }
    localStorage.removeItem('lowestFare');
    localStorage.removeItem('currencies');
}

function infoMsgClear() {
    if ($("#fareCurrenctCode").text().trim() !== "") {
        $("#fareCurrenctCode").text("");
    }
}

function resetFields() {

    debugger;
    selected = {};
    firstClick = false;
    secondClick = false;
    if ($("#fareCurrenctCode").text().trim() !== "") {
        $("#fareCurrenctCode").text("");
    }
    $('#chkOwReturnWithRed').html('');

    $('.calendarParent').css("background-color", "");
    $('.calendarParent2').css("background-color", "");

    localStorage.removeItem("selDepDate");

    $('.calendarParent').removeClass('selected');
    $('.calendarParent2').removeClass('selected');

    $('.date-number, .today').css('background-color', '');

    $('.calendarParent, .today').css({
        'filter': 'none',
        'opacity': '1'
    });
}
