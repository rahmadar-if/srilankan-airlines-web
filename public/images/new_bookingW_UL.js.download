$(document).ready(function () {

    $('[data-toggle="tooltip"]').tooltip();
    $('#departSearch').val('');
    $('#destinationSearch').val('');
    $('#jou').prop('checked', true);
    $("#tidtmp").val("SB");

    $('#calenderLbl').click(function () {
        $("#chatboxid").hide();
    });
    $('#calenderModal').on('hidden.bs.modal', function () {
        $("#chatboxid").show();
    })
    $('#depAirportListModal').on('shown.bs.modal', function () {
        $('#departSearch').focus();
    })
    $('#desAirportListModal').on('shown.bs.modal', function () {
        $('#destinationSearch').focus();
    })

    $("#msgINDalertOk").click(function () {
        $("#msgINDalert").modal('hide');
    });

    $('#flxDateCheck').change(function () {
        if (this.checked) {
            $("#rByPriceFlex").prop('checked', true);
        }
        else {
            $("#rBySchedule").prop('checked', true);
        }
    });

    $('#rByRedumption-Selection').change(function () {
        if (this.checked) {
            $("#rByRedumption").prop('checked', true);
        }
        else {
            $("#rByRedumption").prop('checked', true);
        }
    });

    $("#seladults").val(parseInt(document.getElementById("adultCount").innerHTML));
    $("#selchildren").val(parseInt(document.getElementById("childCount").innerHTML));
    $("#selchildrenyoung").val(parseInt(document.getElementById("yngAdultCount").innerHTML));
    $("#selinfants").val(parseInt(document.getElementById("infantCount").innerHTML));

    //var el = document.getElementById("studentCount");
    //var count = parseInt(el?.textContent || "0");
    //$("#selstudent").val(count);

    $('input[name=resultby-paylater-redeem-checkbox]').click(function (element) {
        var object = element;
        var id = element.currentTarget.id;
        if ($("#" + element.currentTarget.id)[0].checked) {
            $("#rByPayLaterRedeemVoucher").prop('checked', true);
        }
        else {
            $("#rByPayLaterRedeemVoucher").prop('checked', false);
        }
    });

    $('input[name=resultby-cashplusmiles-checkbox]').click(function (element) {
        var object = element;
        var id = element.currentTarget.id;
        if ($("#" + element.currentTarget.id)[0].checked) {
            $("#isCashPlusMiles").prop('checked', true);
        }
        else {
            $("#isCashPlusMiles").prop('checked', false);
        }
    });

    $('input[name=resultby-redeem-checkbox]').click(function (element) {
        var object = element;
        var id = element.currentTarget.id;
        if ($("#" + element.currentTarget.id)[0].checked) {
            $("#rByPriceFlex-Selection").prop('checked', false);
            $("#rByPriceFlex-Selection").attr('disabled', true);
            $("#rByRedumption").prop('checked', true);
        }
        else {
            $("#rBySchedule").prop('checked', true);
            $("#rByPriceFlex-Selection").attr('disabled', false);
        }
    });

    $('input[name=resultby-flex-checkbox]').click(function (element) {
        var object = element;
        var id = element.currentTarget.id;
        if ($("#" + element.currentTarget.id)[0].checked) {
            $("#rByPriceFlex").prop('checked', true);
        }
        else {
            $("#rBySchedule").prop('checked', true);
        }
    });

    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    var today = new Date();
    var nextweek = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 7);

    document.getElementById("depatureDate").getElementsByTagName("span")[0].innerHTML = days[today.getDay()];
    document.getElementById("depatureDate").getElementsByTagName("span")[1].innerHTML = today.getDate() + " " + months[today.getMonth()];
    document.getElementById("returnDate").getElementsByTagName("span")[0].innerHTML = days[nextweek.getDay()];
    document.getElementById("returnDate").getElementsByTagName("span")[1].innerHTML = nextweek.getDate() + " " + months[nextweek.getMonth()];
 
});

function loadDepatureAirports() {

    var cList = $('#depatureAirportList');
    $.each(departureairports, function (i) {
        var li = $('<li/>')
            .addClass('airport-item position-relative')
            .appendTo(cList);

        var aaa = $('<a/>')
            .addClass('d-flex align-items-center position-relative overflow-hidden')
            .appendTo(li);

        // Image Icon (default, positioned normally)
        var icon = $('<img/>')
            .addClass('airport-icon airport-icon-img-sp slide-img')
            .attr('src', '/images/icons/AirportIcon.png')
            .appendTo(aaa);

        // Font Awesome Icon (hidden to the left)
        var faIcon = $('<i/>')
            .addClass('fas fa-plane-departure airport-icon airport-icon-sp slide-fa')
            .css('margin-right', '5px')
            .appendTo(aaa);

        $('<span/>')
            .addClass('airport-code position-relative')
            .text(departureairports[i].code)
            .appendTo(aaa);

        $('<span/>')
            .addClass('separator')
            .text(' | ')
            .appendTo(aaa);

        $('<span/>')
            .addClass('airport-name')
            .text(departureairports[i].name)
            .appendTo(aaa);
    });
}

// Mouse enter: Move image behind airport code & slide in Font Awesome icon
$('#depatureAirportList').on('mouseenter', '.airport-item', function () {
    $(this).css('background-color', '#f0f0f0');

    var imgIcon = $(this).find('img.airport-icon');
    var faIcon = $(this).find('i.airport-icon');

    imgIcon.removeClass('slide-back-img').addClass('slide-out-img'); // Move image behind the airport code
    faIcon.removeClass('slide-back-fa').addClass('slide-in-fa'); // Move FA icon to original place
});

// Mouse leave: Move image back to original place & slide out Font Awesome icon
$('#depatureAirportList').on('mouseleave', '.airport-item', function () {
    $(this).css('background-color', '');

    var imgIcon = $(this).find('img.airport-icon');
    var faIcon = $(this).find('i.airport-icon');

    faIcon.removeClass('slide-in-fa').addClass('slide-back-fa'); // Move FA icon back out
    imgIcon.removeClass('slide-out-img').addClass('slide-back-img'); // Move image back to its original place
});

$('#depatureAirportList').on('click', '.airport-item', function () {

    var airportCode = $(this).find('.airport-code').text().trim();
    var airportName = $(this).find('.airport-name').text().trim();
    glbDepatureCountry = airportCode;
    $("#destCode").removeAttr("style").addClass("airportCode").text("Destination");
    $("#destName").hide();
    depConfirm(airportCode, airportName);
    $('#destinationAirportLbl').prop('disabled', false);
    $('#depAirportListModal').modal('toggle');
    $('#departSearch').text(airportCode + " | " + airportName);
    if (airportCode != "")
        $('#depconbtn').attr('disabled', false);
    $("#icondepSearch").hide();
    $("#depx").show();
    var result = airportCode;
    glbDepatureCode = result;
    $('#seldcity1').val(result);
    $('#suggest1').val(airportCode + " | " + airportName);

    if (result == "LHR" || result == "EDI" || result == "MAN" || result == "NCL" || result == "GLA") {
        $("#adultAgeLHR").show();
        $("#adultAge").hide();
        $("#psryngadlt").show();
        $("#adultToolLHR").show();
        $("#adultTool").hide();
    }
    else {
        $("#psryngadlt").hide();
        $("#adultAgeLHR").hide();
        $("#adultAge").show();
        $("#adultToolLHR").hide();
        $("#adultTool").show();
    }

    //For DXB and AUH destination changes in booking widget
    if (result == "DXB_" || result == "AUH_") {
        $("#msg_DXB_AUH_Promo").modal({ backdrop: 'static' });
    }
    else {
        $("#msg_DXB_AUH_Promo").modal('hide');
    }

    loadsuggest2(result);

    var validCityCodesW = ['KUL', 'KTM', 'DAC', 'CAN', 'PVG'];
    var selectedCityW = $("#seldcity1").val();

    // Get the checkbox element
    var checkbox = document.getElementById("flxDateCheck");
    if (validCityCodesW.includes(selectedCityW)) {

        // Disable the checkbox if it's checked
        if (checkbox.checked) {
            checkbox.disabled = true;
        }
    }
    else {
        checkbox.disabled = false;
    }
});


$("#msg_DXB_AUH_Promo_Ok").click(function () {
    var domain = window.location.origin;
    window.location.replace(domain + "/en_uk/special-offers/promotion/emirates-nbd-promo");
});

$("#msg_DXB_AUH_Promo_No").click(function () {
    $("#msg_DXB_AUH_Promo").modal('hide');
});

function loadsuggest2(a) {

    var ccList = $('#destinationAirportList')
    var second_arr = 'arrivalairportsfrom' + a;
    $('#destinationAirportList').empty();
    $.each(eval(second_arr), function (i) {
        var li = $('<li/>')
            .addClass('airport-item')
            .appendTo(ccList);
        var aaa = $('<a/>')
            .addClass('d-flex align-items-center position-relative overflow-hidden')
            .appendTo(li);
        // Image Icon (default, positioned normally)
        var icon = $('<img/>')
            .addClass('airport-icon airport-icon-img-sp slide-img')
            .attr('src', '/images/icons/AirportIcon.png')
            .appendTo(aaa);

        // Font Awesome Icon (hidden to the left)
        var faIcon = $('<i/>')
            .addClass('fas fa-plane-departure airport-icon-sp airport-icon slide-fa')
            .css('margin-right', '5px')
            .appendTo(aaa);

        $('<span/>')
            .addClass('airport-code')
            .text(eval(second_arr)[i].code)
            .appendTo(aaa);


        $('<span/>')
            .addClass('separator')
            .text(' | ')
            .appendTo(aaa);


        $('<span/>')
            .addClass('airport-name')
            .text(eval(second_arr)[i].name)
            .appendTo(aaa);
    });
}

function getEventTarget(e) {
    e = e || window.event;
    return e.target || e.srcElement;
}

