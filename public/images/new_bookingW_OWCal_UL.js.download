        //  Click picking stuff
        function getClickedInfo2(element, calendar) {

            var clickedInfo = {};
            var clickedCalendar,
                clickedMonth,
                clickedYear;
            clickedCalendar = calendar.name;
            clickedMonth = clickedCalendar == "first" ? month : nextMonth;
            clickedYear = clickedCalendar == "first" ? year : nextYear;

            let dateWithAmt = element[0].innerText;
            let formatedDate = dateWithAmt.split('\n')[0];

            clickedInfo = {
                "calNum": clickedCalendar,
                "date": parseInt(formatedDate),
                "month": clickedMonth,
                "year": clickedYear
            }
            return clickedInfo;
        }

        // Finding between dates MADNESS. Needs refactoring and smartening up :)
        function addChosenDates2(firstClicked, secondClicked, selected) {

            if (secondClicked.date > firstClicked.date ||
                secondClicked.month > firstClicked.month ||
                secondClicked.year > firstClicked.year) {

                var added_year = secondClicked.year;
                var added_month = secondClicked.month;
                var added_date = secondClicked.date;
                // console.log(selected);

                if (added_year > firstClicked.year) {
                    // first add all dates from all months of Second-Clicked-Year
                    selected[added_year] = {};
                    selected[added_year][added_month] = [];
                    for (var i = 1;
                        i <= secondClicked.date;
                        i++) {
                        selected[added_year][added_month].push(i);
                    }

                    added_month = added_month - 1;
                    console.log(added_month);
                    while (added_month >= 0) {
                        selected[added_year][added_month] = [];
                        for (var i = 1;
                            i <= getDaysInMonth2(added_year, added_month);
                            i++) {
                            selected[added_year][added_month].push(i);
                        }
                        added_month = added_month - 1;
                    }

                    added_year = added_year - 1;
                    added_month = 11; // reset month to Dec because we decreased year
                    added_date = getDaysInMonth2(added_year, added_month); // reset date as well

                    // Now add all dates from all months of inbetween years
                    while (added_year > firstClicked.year) {
                        selected[added_year] = {};
                        for (var i = 0; i < 12; i++) {
                            selected[added_year][i] = [];
                            for (var d = 1; d <= getDaysInMonth2(added_year, i); d++) {
                                selected[added_year][i].push(d);
                            }
                        }
                        added_year = added_year - 1;
                    }
                }

                if (added_month > firstClicked.month) {
                    if (firstClicked.year == secondClicked.year) {
                        console.log("here is the month:", added_month);
                        selected[added_year][added_month] = [];
                        for (var i = 1;
                            i <= secondClicked.date;
                            i++) {
                            selected[added_year][added_month].push(i);
                        }
                        added_month = added_month - 1;
                    }
                    while (added_month > firstClicked.month) {
                        selected[added_year][added_month] = [];
                        for (var i = 1;
                            i <= getDaysInMonth2(added_year, added_month);
                            i++) {
                            selected[added_year][added_month].push(i);
                        }
                        added_month = added_month - 1;
                    }
                    added_date = getDaysInMonth2(added_year, added_month);
                }

                for (var i = firstClicked.date + 1;
                    i <= added_date;
                    i++) {
                    selected[added_year][added_month].push(i);
                }
            }
            return selected;
        }

        var elements = document.querySelectorAll('.calendarParent2');
    });

})(jQuery);
