        function callEMFaresMethod2() {

            $("#fareCurrencyCode").text('');
            isRoundTrip = false;

            bindEMFares2().then(fareDataJSON => {
                console.log(fareDataJSON);

                if (fareDataJSON.histogram != null) {
                    localStorage.removeItem("EMFares");

                    // Call the function to process fare data and map to calendars
                    processFareDataAndMapToCalendars2(fareDataJSON);
                    setupFareClickEvents2();

                    initialMsg(isRoundTrip);
                }
            }).catch(error => {
                console.error('Error fetching fare data:', error);
                // Handle error appropriately, maybe show a message to the user
            });
        }

        function bindEMFares2() {

            const journeyType = $("#tidtmp").val() == 'SB' ? "ROUND_TRIP" : "ONE_WAY";
            const origin = $("#seldcity1").val();
            const destination = $("#selacity1").val();
            const currencies = [getCurrencyCode(origin)];
            let histogramType = "OUTBOUND";
            const departureStart = todayDate2();
            const departureEnd = addMonths2(departureStart, 4);

            localStorage.setItem("journeyType", journeyType);
            localStorage.setItem("origin", origin);
            localStorage.setItem("destination", destination);
            localStorage.setItem("currencies", currencies);
            localStorage.setItem("departureStart", departureStart);
            localStorage.setItem("departureEnd", departureEnd);

            // Return a Promise that resolves with fareDataJSON
            return getEMFaresPromise2(journeyType, origin, destination, currencies, departureStart, departureEnd, histogramType)
                .then(response => {
                    var fareData = localStorage.getItem("EMFares");
                    var fareDataJSON = JSON.parse(fareData);
                    return fareDataJSON;
                });
        }

        function getEMFaresPromise2(journeyType, origin, destination, currencies, departureStart, departureEnd, histogramType) {
            return new Promise((resolve, reject) => {
                getEMFares2(journeyType, origin, destination, currencies, departureStart, departureEnd, histogramType, function (response) {
                    resolve(response);
                });
            });
        }

        function getEMFares2(journeyType, origin, destination, currencies, departureStart, departureEnd, histogramType, callback) {

            var currentUrl = window.location.href;
            var parts = currentUrl.split("/");
            var baseUrl = parts.slice(0, 4).join("/");
            var apiUrl = baseUrl + "/Home/getEMFares";

            if (apiUrl !== '') {

                var data = {
                    jnyTyp: journeyType,
                    org: origin,
                    des: destination,
                    curr: currencies,
                    depStr: departureStart,
                    depEnd: departureEnd,
                    hisType: histogramType
                };

                $.ajax({
                    url: apiUrl,
                    type: "POST",
                    data: JSON.stringify(data), // Serialize data object to JSON
                    contentType: "application/json; charset=utf-8",
                    dataType: "text",
                    success: function (response) {
                        localStorage.setItem('EMFares', response);
                        if (typeof callback === 'function') {
                            // Call the callback function with the fetched data
                            callback(response);
                        }
                    },
                    error: function (error) {
                        console.log("Error: " + error.responseText);
                    }
                });
            }
        }

        function processFareDataAndMapToCalendars2(fareData) {

            $('.emFare').remove();
            // Function to format date to match calendar cell IDs (DD)
            function formatDate(date) {
                let d = new Date(date);
                return d.getDate();
            }

            // Extract month and year from both calendar headers
            function getCalendarDate(calendarId) {
                const calendarHeader = document.querySelector(`#${calendarId} .calendar_header h2`).textContent;
                const [calendarMonth, calendarYear] = calendarHeader.split(" ");
                const monthIndex = new Date(Date.parse(calendarMonth + " 1, 2024")).getMonth(); // Get month index
                return new Date(parseInt(calendarYear), monthIndex, 1); // Create date object for calendar
            }

            const calendarFirstDate = getCalendarDate("calendar_first");
            const calendarSecondDate = getCalendarDate("calendar_second");
            const OWcalendarDate = getCalendarDate("ow_calendar_first");

            // Function to append fare data to the appropriate calendar
            function appendFareToCalendar(fare, calendarId) {

                localStorage.setItem('lowestFare', lowestFare);
                const date = new Date(fare.departureDate);
                const formattedDate = formatDate(date);
                const formattedFare = fare.priceSpecification.formattedTotalPrice;
                const fareAmount = parseFloat(formattedFare.replace(/,/g, ''));

                // Find the calendar cell corresponding to the date
                const calendarCell = $(`#${calendarId} .calendar_content div`).filter(function () {
                    // Check for formattedDate and exclude elements with "blank" class and "date-number" class
                    return $(this).text() == formattedDate && !$(this).hasClass('blank') && !$(this).hasClass('date-number');
                });

                // Check if the calendar cell exists
                if (calendarCell.length > 0) {
                    // Append the fare to the calendar cell	
                    const fareElement = $(`<div class="w-100 emFare" style="font-size: xx-small;position: relative;top: -27px;">${formattedFare}</div>`);

                    // Check if the fare is the lowest
                    if (fareAmount === lowestFare) {
                        fareElement.css('color', 'green'); // Set color to green for lowest fare
                    }

                    calendarCell.append(fareElement);
                } else {
                    console.error("Calendar cell not found for date: " + date.toISOString().split('T')[0]);
                }
            }

            // Find the lowest fare
            let lowestFare = Infinity;
            fareData.histogram.forEach(function (item) {
                item.fares.forEach(function (fare) {
                    const fareAmount = parseFloat(fare.priceSpecification.formattedTotalPrice.replace(/,/g, ''));
                    if (fareAmount < lowestFare) {
                        lowestFare = fareAmount;
                    }
                });
            });

            // Apply formatting and coloring to fares
            fareData.histogram.forEach(function (item) {
                item.fares.forEach(function (fare) {
                    const date = new Date(fare.departureDate);

                    // Check if the fare date matches the first calendar month and year
                    if (date.getMonth() === calendarFirstDate.getMonth() && date.getFullYear() === calendarFirstDate.getFullYear()) {
                        appendFareToCalendar(fare, "calendar_first");
                    }

                    // Check if the fare date matches the second calendar month and year
                    if (date.getMonth() === calendarSecondDate.getMonth() && date.getFullYear() === calendarSecondDate.getFullYear()) {
                        appendFareToCalendar(fare, "calendar_second");
                    }

                    // Check if the fare date matches the ow calendar month and year
                    if (date.getMonth() === OWcalendarDate.getMonth() && date.getFullYear() === OWcalendarDate.getFullYear()) {
                        appendFareToCalendar(fare, "ow_calendar_first");
                    }
                });
            });
        }

        function setupFareClickEvents2() {

            var fareElements = document.querySelectorAll('.emFare');
            fareElements.forEach(function (fareElement) {
                fareElement.addEventListener("click", function () {
                    var dateElement = fareElement.parentElement;

                    let parts = dateElement.innerText.split('\n');
                    let dayValue = parts[0].trim();
                    localStorage.setItem("fareDate", dayValue);

                    var fareAmount = fareElement.innerText;
                    localStorage.setItem("fareAmt", fareAmount);
                });
            });
        }

