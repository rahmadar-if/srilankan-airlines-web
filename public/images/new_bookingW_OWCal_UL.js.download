                                    $(this).closest('.calendarParent2').css("background-color", "#0088dd");
                                    //$(this).css("background-color", "#0088dd")
                                }
                            });
                        }
                    }
                }

                highlightDates2(year, month, dateElements1);
            }
        }

        function makeMonthArray22(passed_month, passed_year) { // creates Array specifying dates and weekdays
            var e = [];
            for (var r = 1; r < getDaysInMonth2(passed_year, passed_month) + 1; r++) {
                e.push({
                    day: r,
                    // Later refactor -- weekday needed only for first week
                    weekday: daysArray[getWeekdayNum2(passed_year, passed_month, r)]
                });
            }
            return e;
        }

        function makeWeek22(week) {
            week.empty();
            for (var e = 0; e < 7; e++) {
                week.append("<div>" + daysArray[e].substring(0, 3) + "</div>")
            }
        }

        function getDaysInMonth2(currentYear, currentMon) {
            return (new Date(currentYear, currentMon + 1, 0)).getDate();
        }

        function getWeekdayNum2(e, t, n) {
            return (new Date(e, t, n)).getDay();
        }

        function checkToday2(e) {
            var todayDate = today.getFullYear() + '/' + (today.getMonth() + 1) + '/' + today.getDate();
            var checkingDate = e.getFullYear() + '/' + (e.getMonth() + 1) + '/' + e.getDate();
            return todayDate == checkingDate;
        }

        function getAdjacentMonth2(curr_month, curr_year, direction) {
            var theNextMonth;
            var theNextYear;
            if (direction == "next") {
                theNextMonth = (curr_month + 1) % 12;
                theNextYear = (curr_month == 11) ? curr_year + 1 : curr_year;
            } else {
                theNextMonth = (curr_month == 0) ? 11 : curr_month - 1;
                theNextYear = (curr_month == 0) ? curr_year - 1 : curr_year;
            }
            return [theNextMonth, theNextYear];
        }

        function b2() {

            today = new Date;
            year = today.getFullYear();
            month = today.getMonth();
            var nextDates = getAdjacentMonth2(month, year, "next");
            nextMonth = nextDates[0];
            nextYear = nextDates[1];
        }

