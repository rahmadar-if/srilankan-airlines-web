ce + \u0026quot;; path=\/; max-age=86400\u0026quot;; \/\/ Stores for 1 day\n    }\n    return utmSource;\n}\n","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":347},{"function":"__html","metadata":["map"],"consent":["list","analytics_storage"],"once_per_event":true,"vtp_html":"\u003Cscript async data-gtmsrc=\"https:\/\/cdn.quantummetric.com\/qscripts\/quantum-srilankanairlines.js\" type=\"text\/gtmscript\"\u003E\u003C\/script\u003E","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":379},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":["template","\u003Cstyle\u003E\n#sl-popup-overlay{\n    position:fixed;\n    top:0;\n    left:0;\n    width:100%;\n    height:100%;\n    background:rgba(0,0,0,0.35); \/* soft dim background *\/\n    display:flex;\n    justify-content:center;\n    align-items:center;\n    z-index:9999;\n}\n\n#sl-popup-modal{\n    background:#fff;\n    width:90%;\n    max-width:600px;\n    border-radius:12px;\n    padding:30px;\n    font-family:Segoe UI,sans-serif;\n    box-shadow:0 10px 40px rgba(0,0,0,.25);\n    animation:popIn 0.25s ease;\n    text-align:left;\n}\n\n@keyframes popIn {\n    from { transform: scale(0.9); opacity:0; }\n    to { transform: scale(1); opacity:1; }\n}\n\n#sl-popup-modal h2{\n    margin-top:0;\n    color:#0074b7;\n}\n\n#sl-popup-modal p{\n    line-height:1.6;\n    color:#333;\n    font-size:15px;\n}\n\n#sl-popup-modal a{\n    color:#0074b7;\n}\n\n#sl-close-btn{\n    margin-top:20px;\n    background:#0074b7;\n    color:#fff;\n    border:none;\n    padding:12px 25px;\n    border-radius:6px;\n    cursor:pointer;\n    font-size:15px;\n    width:100%;\n}\n\u003C\/style\u003E\n\n\u003Cscript type=\"text\/gtmscript\"\u003Etry{var nationality=",["escape",["macro",85],8,16],",departure=",["escape",["macro",86],8,16],";if(nationality\u0026\u0026departure\u0026\u0026nationality.toLowerCase()===\"nepalese\"\u0026\u0026departure.toLowerCase()===\"ktm\"){var html='\\x3cdiv id\\x3d\"sl-popup-overlay\"\\x3e\\x3cdiv id\\x3d\"sl-popup-modal\"\\x3e\\x3ch2\\x3eImportant Information\\x3c\/h2\\x3e\\x3cp\\x3eYou are eligible for a tax waiver of \\x3cstrong\\x3eNPR 1,130 per passenger\\x3c\/strong\\x3e. To secure this, select \\x3cstrong\\x3e\"Pay Later\"\\x3c\/strong\\x3e at checkout and complete payment at the \\x3cstrong\\x3eSriLankan Airlines Kathmandu Office\\x3c\/strong\\x3e within \\x3cstrong\\x3e24 hours\\x3c\/strong\\x3e.\\x3c\/p\\x3e\\x3cp\\x3eFor support, call \\x3ca href\\x3d\"tel:+97714534847\"\\x3e+977 1 453 4847\\x3c\/a\\x3e or email \\x3ca href\\x3d\"mailto:ktmul@zenithgroup.org\"\\x3ektmul@zenithgroup.org\\x3c\/a\\x3e.\\x3c\/p\\x3e\\x3cbutton id\\x3d\"sl-close-btn\"\\x3eClose\\x3c\/button\\x3e\\x3c\/div\\x3e\\x3c\/div\\x3e';\ndocument.body.insertAdjacentHTML(\"beforeend\",html);document.addEventListener(\"click\",function(a){a.target\u0026\u0026a.target.id===\"sl-close-btn\"\u0026\u0026(a=document.getElementById(\"sl-popup-overlay\"))\u0026\u0026a.remove()})}}catch(a){console.log(a)};\u003C\/script\u003E"],"vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":407},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":"\u003Cstyle\u003E\n  \/* Animation *\/\n  .flysmiles-fade-in {\n    animation: flyFadeIn 0.4s ease-in-out both;\n  }\n\n  \/* Fade in *\/\n  @keyframes flyFadeIn {\n    from {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  \/* Modal overlay *\/\n  #flysmilesModal {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0,0,0,0.6);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 9999;\n    \n    overflow-y: hidden; \/* Vertical scroll if needed *\/\n    overflow-x: hidden;\n  }\n\n  \/* Modal dialog *\/\n  #flysmilesModal .modal-dialog {\n    max-width: 500px;\n    width: 100%;\n    margin: 2rem;\n    \n    max-height: 100vh;\n    display: flex;\n    flex-direction: column;\n  }\n\n  \/* Modal content *\/\n  #flysmilesModal .modal-content {\n    background-color: white;\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 8px 20px rgba(0,0,0,0.25);\n    display: flex;\n    flex-direction: column;\n    \n    max-height: 100vh;\n    overflow-y: auto;\n  }\n\n  \/* FlySmiLe Header image *\/\n  #flysmilesModal .flysmiles-img {\n    height: 350px;\n    width: 100%;\n    object-fit: cover;\n    object-position: center bottom;\n  }\n\n  \/* FlySmiLe Logo *\/\n  #flysmilesModal .flysmiles-logo {\n    height: 40px;\n    display: inline-block;\n  }\n\n  \/* Headings Titles *\/\n  #flysmilesModal h2,\n  #flysmilesModal h3 {\n    text-align: center;\n    margin: 0.5rem 0;\n    margin-bottom: 0.5rem;\n  }\n  #flysmilesModal h2 {\n    color: #0080bb;\n  }\n  #flysmilesModal h3 {\n    color: #666;\n  }\n\n  \/* Body text *\/\n  #flysmilesModal .modal-body {\n    padding: 1rem 1.5rem;\n  }\n\n  \/* Modal Body Paragraphs *\/\n  #flysmilesModal .modal-body p {\n    text-align: justify;\n    font-size: 1.25rem; \/* Larger font size *\/\n    line-height: 1.5;   \/* Better readability *\/\n    margin-bottom: 0.25rem;\n  }\n  \n  \/* Modal Paragraph Text Colors *\/\n  #flysmilesModal .text-secondary { color: #666;  }\n  #flysmilesModal .text-muted { color: #999;}\n\n  \/* Footer *\/\n  #flysmilesModal .modal-footer {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1rem;\n    justify-content: space-around;\n    align-items: center;\n    padding: 1rem;\n    border-top: none;\n  }\n\n  \/* QR Code *\/\n  #flysmilesModal .FlySmile-Registration-QRCode {\n    width: 120px;\n    height: 120px;\n    object-fit: contain;\n    background-color: #fff;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  \/* Buttons *\/\n  #flysmilesModal button {\n    height: 50px;\n    min-width: 180px;\n    padding: 0 1rem;\n    font-weight: 600;\n    border: none;\n    border-radius: 25px;\n    cursor: pointer;\n    transition: background-color 0.2s ease;\n    color: white;\n    background-color: #0080bb;\n  }\n\n  \/* Button Hovers *\/\n  #flysmilesModal button:hover {\n    background-color: #005b85;\n  }\n\n\u003C\/style\u003E\n\n\u003Cscript type=\"module\"\u003E\n(() =\u003E {\n  const isLoggedIn = !!document.querySelector('.miles-asset-container.ng-star-inserted');\n\n  if (isLoggedIn) return;\n  if (sessionStorage.getItem('flysmilesModalShown')) return;\n\n  const insertPopup = () =\u003E {\n    if (document.getElementById('flysmilesModal')) return;\n\n    const modalHTML = `\n      \u003Cdiv id=\"flysmilesModal\" class=\"flysmiles-fade-in\"\u003E\n        \u003Cdiv class=\"modal-dialog\"\u003E\n          \u003Cdiv class=\"modal-content\"\u003E\n            \u003Cimg src=\"https:\/\/www.srilankan.com\/images\/FlySmile-PopUp-Header.png\" alt=\"FlySmiLes Banner\" class=\"flysmiles-img\"\u003E\n            \u003Cdiv class=\"modal-body\"\u003E\n              \u003Ch2\u003E\n                \u003Cimg src=\"https:\/\/flysmiles.com\/assets\/images\/logo.png\" alt=\"FlySmiLes Logo\" class=\"flysmiles-logo\"\u003E\n              \u003C\/h2\u003E\n              \u003Ch3\u003E\n                Join now and experience a world of rewards\n              \u003C\/h3\u003E\n              \u003Cp class=\"text-secondary\"\u003E\n                Become a member of FlySmiLes and enjoy reward flights, upgrades and a range of benefits every time you fly with SriLankan Airlines.\n              \u003C\/p\u003E\n              \u003Cp class=\"text-muted\"\u003E\n                Sign-up today and make your miles go further!\n              \u003C\/p\u003E\n            \u003C\/div\u003E\n            \n            \u003Cdiv class=\"modal-footer\"\u003E\n              \u003Cimg src=\"https:\/\/www.srilankan.com\/images\/FlySmile-Registration-QR.png\" alt=\"FlySmiles QR Code\" class=\"FlySmile-Registration-QRCode\"\u003E\n              \u003Cdiv style=\"display:flex; flex-direction:column; gap:10px;\"\u003E\n                \u003Cbutton id=\"flysmilesRegisterBtn\"\u003ERegister Now\u003C\/button\u003E\n                \u003Cbutton id=\"flysmilesDismissBtn\"\u003EMaybe Later\u003C\/button\u003E\n              \u003C\/div\u003E\n            \u003C\/div\u003E\n          \u003C\/div\u003E\n        \u003C\/div\u003E\n      \u003C\/div\u003E\n    `;\n\n    document.body.insertAdjacentHTML('beforeend', modalHTML);\n\n    const modal = document.getElementById('flysmilesModal');\n    const registerBtn = document.getElementById('flysmilesRegisterBtn');\n    const dismissBtn = document.getElementById('flysmilesDismissBtn');\n\n    registerBtn.addEventListener('click', () =\u003E {\n      sessionStorage.setItem('flysmilesModalShown', 'true');\n      window.open('https:\/\/www.flysmiles.com\/flysmiles\/register?utm_id=fs\u0026utm_source=regbutton', '_blank');\n      modal.remove();\n      window.dataLayer?.push({ event: 'flysmiles_register_click' });\n    });\n\n    dismissBtn.addEventListener('click', () =\u003E {\n      sessionStorage.setItem('flysmilesModalShown', 'true');\n      modal.remove();\n      window.dataLayer?.push({ event: 'flysmiles_popup_dismissed' });\n    });\n  };\n\n  const waitForBodyAndInsert = () =\u003E {\n    if (document.body) {\n      setTimeout(insertPopup, 1000);\n    } else {\n      const observer = new MutationObserver(() =\u003E {\n        if (document.body) {\n          observer.disconnect();\n          setTimeout(insertPopup, 1000);\n        }\n      });\n      observer.observe(document.documentElement, { childList: true, subtree: true });\n    }\n  };\n  waitForBodyAndInsert();\n})();\n\u003C\/script\u003E\n","vtp_supportDocumentWrite":true,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"vtp_usePostscribe":true,"tag_id":473},{"function":"__ht