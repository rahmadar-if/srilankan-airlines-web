1\" style=\"display:none\" src=\"https:\/\/www.facebook.com\/tr?id=769133355292390\u0026amp;ev=PageView\u0026amp;noscript=1\"\u003E\u003C\/noscript\u003E\n\n"],"vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":475},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":["template","\n\u003Cscript type=\"text\/gtmscript\"\u003E!function(b,e,f,g,a,c,d){b.fbq||(a=b.fbq=function(){a.callMethod?a.callMethod.apply(a,arguments):a.queue.push(arguments)},b._fbq||(b._fbq=a),a.push=a,a.loaded=!0,a.version=\"2.0\",a.queue=[],c=e.createElement(f),c.async=!0,c.src=g,d=e.getElementsByTagName(f)[0],d.parentNode.insertBefore(c,d))}(window,document,\"script\",\"https:\/\/connect.facebook.net\/en_US\/fbevents.js\");fbq(\"init\",\"2587865168058367\");fbq(\"track\",\"PageView\");\nfbq(\"track\",\"InitiateCheckout\",{value:\"",["escape",["macro",87],7],"\",currency:\"",["escape",["macro",88],7],"\",Origin:\"",["escape",["macro",86],7],"\",Departure_Date:\"",["escape",["macro",82],7],"\",Destination:\"",["escape",["macro",89],7],"\",Arrival_Date:\"",["escape",["macro",90],7],"\",Modified_Departure_Date:\"",["escape",["macro",93],7],"\",Modified_Arrival_Date:\"",["escape",["macro",94],7],"\",Pax_Count:\"",["escape",["macro",91],7],"\",Trip_Type:\"",["escape",["macro",92],7],"\"});\u003C\/script\u003E\n\u003Cnoscript\u003E\u003Cimg height=\"1\" width=\"1\" style=\"display:none\" src=\"https:\/\/www.facebook.com\/tr?id=2587865168058367\u0026amp;ev=PageView\u0026amp;noscript=1\"\u003E\u003C\/noscript\u003E\n"],"vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":478},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":["template","\n\u003Cscript type=\"text\/gtmscript\"\u003E!function(b,e,f,g,a,c,d){b.fbq||(a=b.fbq=function(){a.callMethod?a.callMethod.apply(a,arguments):a.queue.push(arguments)},b._fbq||(b._fbq=a),a.push=a,a.loaded=!0,a.version=\"2.0\",a.queue=[],c=e.createElement(f),c.async=!0,c.src=g,d=e.getElementsByTagName(f)[0],d.parentNode.insertBefore(c,d))}(window,document,\"script\",\"https:\/\/connect.facebook.net\/en_US\/fbevents.js\");fbq(\"init\",\"2587865168058367\");fbq(\"track\",\"PageView\");\nfbq(\"track\",\"Purchase\",{value:\"",["escape",["macro",87],7],"\",currency:\"",["escape",["macro",88],7],"\",Origin:\"",["escape",["macro",86],7],"\",Departure_Date:\"",["escape",["macro",82],7],"\",Destination:\"",["escape",["macro",89],7],"\",Arrival_Date:\"",["escape",["macro",90],7],"\",Modified_Departure_Date:\"",["escape",["macro",93],7],"\",Modified_Arrival_Date:\"",["escape",["macro",94],7],"\",Pax_Count:\"",["escape",["macro",91],7],"\",Trip_Type:\"",["escape",["macro",92],7],"\"});\u003C\/script\u003E\n\u003Cnoscript\u003E\u003Cimg height=\"1\" width=\"1\" style=\"display:none\" src=\"https:\/\/www.facebook.com\/tr?id=2587865168058367\u0026amp;ev=PageView\u0026amp;noscript=1\"\u003E\u003C\/noscript\u003E\n"],"vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":480},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":["template","\u003Clink href=\"https:\/\/cdnjs.cloudflare.com\/ajax\/libs\/font-awesome\/5.15.4\/css\/all.min.css\" rel=\"stylesheet\"\u003E\n\n\u003Cstyle\u003E\n  \/* Animation *\/\n  .currency-popup-fade-in {\n    animation: currencyFadeIn 0.4s ease-in-out both;\n  }\n\n  @keyframes currencyFadeIn {\n    from {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n\n  \/* Modal overlay *\/\n  #currencyPopUpModal {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0,0,0,0.6);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 9999;\n    overflow: hidden;\n  }\n\n  \/* Modal dialog *\/\n  #currencyPopUpModal .modal-dialog {\n    max-width: 500px;\n    width: 100%;\n    margin: 2rem;\n    display: flex;\n    flex-direction: column;\n  }\n\n  \/* Modal content *\/\n  #currencyPopUpModal .modal-content {\n    background-color: #fff;\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 8px 20px rgba(0,0,0,0.25);\n    display: flex;\n    flex-direction: column;\n    overflow-y: auto;\n  }\n\n  \/* Titles \u0026 Text *\/\n  #currencyPopUpModal h2 {\n    text-align: center;\n    margin: 0.5rem 0;\n    color: #0080bb;\n  }\n\n  #currencyPopUpModal h3 {\n    text-align: center;\n    margin: 0.5rem 0;\n    color: #555;\n    line-height: 1.5;\n  }\n\n  #currencyPopUpModal .modal-body {\n    padding: 1rem 1.5rem;\n  }\n\n  #currencyPopUpModal .modal-body p {\n    text-align: justify;\n    font-size: 1.1rem;\n    line-height: 1.6;\n    margin-bottom: 0.75rem;\n    color: #444;\n  }\n\n  \/* Footer *\/\n  #currencyPopUpModal .modal-footer {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 1rem;\n    border-top: none;\n  }\n\n  \/* Buttons *\/\n  #currencyPopUpModal button {\n    height: 50px;\n    min-width: 180px;\n    padding: 0 1rem;\n    font-weight: 600;\n    border: none;\n    border-radius: 25px;\n    cursor: pointer;\n    color: #fff;\n    background-color: #0080bb;\n    transition: background-color 0.2s ease;\n  }\n\n  #currencyPopUpModal button:hover {\n    background-color: #005b85;\n  }\n\u003C\/style\u003E\n\n\u003Cscript type=\"module\"\u003E\n(() =\u003E {\n  const DepartureCMB = ",["escape",["macro",96],8,16],";\n\n  if (sessionStorage.getItem('CurrencyPopUpShown')) return;\n\n  const insertPopup = (htmlMessage) =\u003E {\n    if (document.getElementById('currencyPopUpModal')) return;\n\n    const modalHTML = `\n      \u003Cdiv id=\"currencyPopUpModal\" class=\"currency-popup-fade-in\"\u003E\n        \u003Cdiv class=\"modal-dialog\"\u003E\n          \u003Cdiv class=\"modal-content\"\u003E\n            \u003Cdiv class=\"modal-body\"\u003E\n              \u003Ch2\u003E\n                \u003Ci class=\"fas fa-exclamation-circle\" style=\"font-size:48px;color:red\"\u003E\u003C\/i\u003E\n              \u003C\/h2\u003E     \n              ${htmlMessage}\n            \u003C\/div\u003E\n            \u003Cdiv class=\"modal-footer\"\u003E\n              \u003Cbutton id=\"currencyPopUpDismissBtn\"\u003EClose\u003C\/button\u003E\n            \u003C\/div\u003E\n          \u003C\/div\u003E\n        \u003C\/div\u003E\n      \u003C\/div\u003E\n    `;\n\n    document.body.insertAdjacentHTML('beforeend', modalHTML);\n\n    const modal = document.getElementById('currencyPopUpModal');\n    const dismissBtn = document.getElementById('currencyPopUpDismissBtn');\n\n    dismissBtn.addEventListener('click', () =\u003E {\n      sessionStorage.setItem('CurrencyPopUpShown', 'true');\n      modal.remove();\n      window.dataLayer?.push({ event: 'CurrencyPopUp_dismissed' });\n    });\n  };\n\n  const waitForBodyAndInsert = (htmlMessage) =\u003E {\n    if (document.body) {\n      setTimeout(() =\u003E insertPopup(htmlMessage), 3000);\n    } else {\n      const observer = new MutationObserver(() =\u003E {\n        if (document.body) {\n          observer.disconnect();\n          setTimeout(() =\u003E insertPopup(htmlMessage), 3000);\n        }\n      });\n      observer.observe(document.documentElement, { childList: true, subtree: true });\n    }\n  };\n\n  \/\/ Show popup content based on departure airport\n  if (DepartureCMB === 'CMB') {\n    waitForBodyAndInsert(`\n      \u003Ch3\u003E\n        If you are using a card issued by a Sri Lankan bank, please ensure that your payment is completed in Sri Lankan Rupees (LKR) to comply with government regulatory requirements.\n      \u003C\/h3\u003E\n    `);\n  } else {\n    waitForBodyAndInsert(`\n      \u003Ch3\u003EIf you are using a card issued by a Sri Lankan bank, please ensure that your payment is completed in Sri Lankan Rupees (LKR) to comply with government regulatory requirements.\u003C\/h3\u003E\n      \u003Ch3\u003EPlease use the currency conversion option to complete your payment in LKR.\u003C\/h3\u003E\n    `);\n  }\n})();\n\u003C\/script\u003E\n"],"vtp_supportDocumentWrite":true,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"vtp_usePostscribe":true,"tag_id":494},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":"\u003Cstyle\u003E\n  .nps-fade-in {\n    animation: npsFadeIn 0.5s ease-in-out both;\n  }\n\n  @keyframes npsFadeIn {\n    from { opacity: 0; transform: scale(0.95); }\n    to { opacity: 1; transform: scale(1); }\n  }\n\n  \/* Smileys container *\/\n  .nps-smileys {\n    display: flex;\n    justify-content: space-around;\n    flex-wrap: wrap;\n    gap: 14px;\n  }\n\n  .nps-smileys a {\n    position: relative;\n    width: 54px;\n    height: 54px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    transition: transform 0.2s ease;\n  }\n\n  .nps-smileys a:hover {\n    transform: scale(1.2);\n  }\n\n  .nps-smileys a img {\n    width: 40px;\n    height: 40px;\n    cursor: pointer;\n    margin: 0;\n  }\n\n  \/* Smileys colors *\/\n  .nps-very-satisfied { background-color: #d4edda; border: 2px solid #007b34; }\n  .nps-satisfied { background-color: #fff3cd; border: 2px solid #339f61; }\n  .nps-neutral { background-color: #e2e3e5; border: 2px solid #f18e5d; }\n  .nps-dissatisfied { background-color: #f8d7da; border: 2px solid #ea560d; }\n  .nps-very-dissatisfied { background-color: #f5c6cb; border: 2px solid #d30535; }\n\n  \/* Modal base *\/\n  #npsModal {\n    position: fixed;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    background: rgba(0,0,0,0.5);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 9999;\n  }\n\n  #npsModal .modal-dialog {\n    max-width: 500px;\n    width: 90%;\n  }\n\n  #npsModal .modal-content {\n    background: #fff;\n    border-radius: 16px;\n    overflow: hidden;\n    padding: 1.5rem;\n    text-align: center;\n    font-family: Arial, sans-serif;\n    box-shadow: 0 8px 20px rgba(0,0,0,0.2);\n  }\n\n  #npsModal h3 {\n    margin-bottom: 2rem;\n    font-size: 2rem;\n    font-weight: normal;\n    color: #2c2c2c;\n  }\n\n  #npsModal .modal-header {\n    border-bottom: none;\n    padding: 0;\n    display: flex;\n    justify-content: flex-end;\n  }\n\n  #npsModal .btn-close {\n    background: none;\n    border: none;\n    color: #666;\n    font-size: 2rem;\n    cursor: pointer;\n    line-height: 1;\n  }\n\n  #npsModal .btn-close:hover {\n    color: #000;\n  }\n\n  \/* Feedback form *\/\n  #feedback-form { display: none; margin-top: 15px; }\n  #feedback-comment {\n    width: 100%;\n    height: 80px;\n    padding: 8px;\n    border-radius: 6px;\n    border: 1px solid #ccc;\n    resize: none;\n  }\n  #feedback-form button {\n    margin-top: 10px;\n    padding: 12px 25px;\n    border: none;\n    background: #0073e6;\n    color: #fff;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 1.5rem;\n  }\n  #feedback-msg {\n    margin-top: 10px;\n    font-size: 14px;\n    color: green;\n    display: none;\n  }\n\u003C\/style\u003E\n\n\u003Cscript type=\"module\"\u003E\n(() =\u003E {\n    let NPSScore = null;\n\n    const insertNPSPopup = () =\u003E {\n        if (document.getElementById('npsModal')) return;\n\n    const modalHTML = `\n        \u003Cdiv id=\"npsModal\" class=\"nps-fade-in\"\u003E\n            \u003Cdiv class=\"modal-dialog\"\u003E\n            \u003Cdiv class=\"modal-content\"\u003E\n                \u003Cdiv class=\"modal-header\"\u003E\n                \u003Cbutton id=\"npsCloseBtn\" class=\"btn-close\"\u003E\u0026times;\u003C\/button\u003E\n                \u003C\/div\u003E\n                \u003Cdiv class=\"modal-body\"\u003E\n                \u003Ch3\u003EHow would you rate your overall booking experience?\u003C\/h3\u003E\n                \u003Cdiv class=\"nps-smileys\"\u003E\n                    \u003Ca href=\"https:\/\/www.srilankan.com\/en_uk\/corporate\/corporate-smile-face?id=1\" class=\"nps-very-dissatisfied\" data-score=\"1\"\u003E\u003Cimg src=\"https:\/\/www.srilankan.com\/images\/NPS-Very_Dissatisfied.png?SITE=CBGVCNEW\" \/\u003E\u003C\/a\u003E\n                    \u003Ca href=\"https:\/\/www.srilankan.com\/en_uk\/corporate\/corporate-smile-face?id=2\" class=\"nps-dissatisfied\" data-score=\"2\"\u003E\u003Cimg src=\"https:\/\/www.srilankan.com\/images\/NPS-Dissatisfied.png?SITE=CBGVCNEW\" \/\u003E\u003C\/a\u003E\n                    \u003Ca href=\"https:\/\/www.srilankan.com\/en_uk\/corporate\/corporate-smile-face?id=3\" class=\"nps-neutral\" data-score=\"3\"\u003E\u003Cimg src=\"https:\/\/www.srilankan.com\/images\/NPS-Neutral.png?SITE=CBGVCNEW\" \/\u003E\u003C\/a\u003E\n                    \u003Ca href=\"https:\/\/www.srilankan.com\/en_uk\/corporate\/corporate-smile-face?id=4\" class=\"nps-satisfied\" data-score=\"4\"\u003E\u003Cimg src=\"https:\/\/www.srilankan.com\/images\/NPS-Satisfied.png?SITE=CBGVCNEW\" \/\u003E\u003C\/a\u003E\n                    \u003Ca href=\"https:\/\/www.srilankan.com\/en_uk\/corporate\/corporate-smile-face?id=5\" class=\"nps-very-satisfied\" data-score=\"5\"\u003E\u003Cimg src=\"https:\/\/www.srilankan.com\/images\/NPS-Very_Satisfied.png?SITE=CBGVCNEW\" \/\u003E\u003C\/a\u003E                   \n                \u003C\/div\u003E\n\n                \u003Cdiv id=\"feedback-form\"\u003E\n                    \u003Ctextarea id=\"feedback-comment\" placeholder=\"Please share your feedback...\"\u003E\u003C\/textarea\u003E\n                    \u003Cbutton id=\"feedback-submit\"\u003ESubmit\u003C\/button\u003E\n                    \u003Cp id=\"feedback-msg\"\u003EThank you! Your feedback has been sent.\u003C\/p\u003E\n                \u003C\/div\u003E\n                \u003C\/div\u003E\n            \u003C\/div\u003E\n            \u003C\/div\u003E\n        \u003C\/div\u003E`;\n\n    document.body.insertAdjacentHTML('beforeend', modalHTML);\n\n    const modal = document.getElementById('npsModal');\n    const closeBtn = document.getElementById('npsCloseBtn');\n    const smileyLinks = modal.querySelectorAll('.nps-smileys a');\n    const feedbackForm = document.getElementById('feedback-form');\n    const feedbackSubmit = document.getElementById('feedback-submit');\n    const feedbackMsg = document.getElementById('feedback-msg');\n\n    \/\/const current_Page2 = window.location.pathname.split('\/').pop() || \"homepage\";\n    const currentPage  = digitalData.page.category.primaryCategory.split('\/').pop();\n\n    \/\/const visitBase = \"https:\/\/www.srilankan.com\/en_uk\/flying-with-us\/visit-Sri-Lanka\";\n    const visitSriLankaURL = \"https:\/\/www.srilankan.com\/en_uk\/flying-with-us\/visit-Sri-Lanka\";\n\n    \/\/ Close modal (NO redirect here)\n    const closePopup = () =\u003E {\n        modal.remove();\n        sessionStorage.setItem('npsPopupShown', 'true');\n        window.dataLayer?.push({ event: 'nps_popup_dismissed' });\n    };\n\n    closeBtn.addEventListener('click', closePopup);\n\n    smileyLinks.forEach(link =\u003E {\n        link.addEventListener('click', e =\u003E {\n            e.preventDefault();\n\n            NPSScore = link.getAttribute('data-score');\n            const nps_URL = link.getAttribute('href');\n\n            \/\/ 1️⃣ SILENT BEACON HIT\n            try {\n                navigator.sendBeacon(nps_URL);\n                console.log(\"Beacon sent:\", nps_URL);\n            } catch(err) {\n                \/\/fetch(smileUrl, { mode: \"no-cors\" });\n                console.log(\"Beacon send failed, fallback triggered:\", nps_URL);\n            }\n\n            \/\/ 2️⃣ UTM REDIRECT URL\n            const utmUrl = `${visitSriLankaURL}?utm_id=NPS_popUp\u0026utm_source=${currentPage}\u0026utm_medium=${NPSScore}`;\n            console.log(\"NPS - VisitSriLanka URL:\", utmUrl);\n\n            \/\/ 3️⃣ LOW SCORE → Show feedback form only\n            if (NPSScore === \"1\" || NPSScore === \"2\") {\n                feedbackForm.style.display = 'block';\n                return;\n            }\n\n            \/\/ 4️⃣ HIGH SCORE → Redirect with UTM\n            window.open(utmUrl, \"_blank\");\n            feedbackMsg.style.display = 'block';\n            feedbackMsg.textContent = \"Thank you for your response!\";\n\n            setTimeout(closePopup, 1500);\n        });\n    });\n\n    feedbackSubmit.addEventListener('click', () =\u003E {\n        const comment = document.getElementById('feedback-comment').value.trim();\n        if (!comment) { \n            alert(\"Please enter your feedback.\"); \n            return;\n        }\n\n        const xhr = new XMLHttpRequest();\n        const url = \"https:\/\/script.google.com\/macros\/s\/AKfycbzJRLUFdZLnHvcU2izNd9bm8kYUURnedd5azhlGHPmhAKtycV0T50HO1xyf6kehLLl2bA\/exec\";\n\n        xhr.open(\"POST\", url, true);\n        xhr.setRequestHeader(\"Content-Type\", \"application\/x-www-form-urlencoded\");\n\n        xhr.onreadystatechange = () =\u003E {\n            if (xhr.readyState === 4) {\n            if (xhr.status === 200) {\n\n                feedbackMsg.style.display = 'block';\n\n                \/\/ Redirect with UTM for low scores\n                const utmFeedbackUrl = `${visitSriLankaURL}?utm_id=NPS_popUp\u0026utm_source=${currentPage}\u0026utm_medium=${NPSScore}`;\n                window.open(utmFeedbackUrl, \"_blank\");\n\n                setTimeout(closePopup, 1500);\n            } else {\n                alert(\"Error sending feedback.\");\n            }\n            }\n        };\n\n        xhr.send(\n            \"score=\" + encodeURIComponent(NPSScore) +\n            \"\u0026comment=\" + encodeURIComponent(comment) +\n            \"\u0026url=\" + encodeURIComponent(window.location.href)\n        );\n        });\n    };\n\n    if (!sessionStorage.getItem('npsPopupShown')) {\n        setTimeout(insertNPSPopup, 2000);\n    }\n\n})();\n\u003C\/script\u003E\n","vtp_suppor