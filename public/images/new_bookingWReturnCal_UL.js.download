(function ($) {

    "use strict";

    $(document).ready(function () {

        function isSafariR() {
            const ua = navigator.userAgent;
            const isWebkit = CSS.supports("-webkit-touch-callout", "none");
            const isSafari = /^((?!chrome|android|crios|firefox|fxios).)*safari/i.test(ua.toLowerCase());
            const isMac = ua.includes("Macintosh");
            return isSafari && isMac && isWebkit;
        }

        function isiPhoneUsingChromeR() {
            const ua = navigator.userAgent.toLowerCase();

            // Check for iPhone (iOS)
            const isIPhone = /iphone|ipod/.test(ua);

            // Check for Chrome on iOS (CriOS) or regular Chrome
            const isChrome = ua.includes('crios') || ua.includes('chrome');

            return isIPhone && isChrome;
        }

        function isAppleDevice() {
            const ua = navigator.userAgent.toLowerCase();
            return /macintosh|mac os|iphone|ipad|ipod/.test(ua);
        }

        localStorage.removeItem("selDepDate");
