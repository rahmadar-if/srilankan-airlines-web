                        selected = {};
                        selected[firstClicked.year] = {};
                        selected[firstClicked.year][firstClicked.month] = [firstClicked.date];

                    } else if (firstClickDateObj.getTime() ==
                        secondClickDateObj.getTime()) {
                    }

                    // add between dates to [selected]
                    firstDate = firstClicked.date;
                    firstMonth = firstClicked.month;
                    firstDay = firstClicked.year;
                    secondDate = secondClicked.date;
                    secondMonth = secondClicked.month;
                    secondDay = secondClicked.year;
                    isMonth = false;
                    var i = ["January", "February", "March", "April", "May",
                        "June", "July", "August", "September", "October",
                        "November", "December"];
                    var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                    var ssDate = secondDay + "/" + (secondMonth + 1) + "/" + secondDate

                    //get Calendar Data
                    var dateStr = new Date(firstClicked.year, firstClicked.month, firstClicked.date);
                    console.log(dateStr);

                    sbDate = days[dateStr.getDay()];
                    sbMonth = dateStr.getDate() + " " + i[dateStr.getMonth()];
